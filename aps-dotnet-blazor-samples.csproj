<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApsSamples</RootNamespace>
    <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>917f7e38-92f4-4af8-8aeb-5228523de101</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Data\creation-jobs.json" />
    <Content Remove="Data\linking-jobs.json" />
    <Content Remove="Data\sheet-creation-jobs.json" />
    <Content Remove="Data\agent-conversations.json" />
    <Content Remove="Data\agent-tasks.json" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Autodesk.Authentication" Version="2.0.1" />
    <PackageReference Include="Autodesk.Construction.AccountAdmin" Version="2.2.1" />
    <PackageReference Include="Autodesk.DataManagement" Version="2.1.3" />
    <PackageReference Include="Autodesk.Forge.DesignAutomation" Version="6.0.2" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.0" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.0" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.0" />
    <PackageReference Include="OllamaSharp" Version="5.4.27" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\" />
  </ItemGroup>
</Project>
