@inherits LayoutComponentBase
@using ApsSamples.Services
@inject IUserSessionService UserSession
@inject ISelectedProjectService SelectedProjectService
@inject NavigationManager NavigationManager

<FluentLayout>
    <FluentHeader>
            <div>
                Autodesk Platform Services .NET Blazor Samples
            </div>
            @if (_selectedProject != null)
            {
                <FluentSpacer Width="20"></FluentSpacer>
                <span style="font-size: 14px;">Project: @_selectedProject.ProjectName</span>
                <FluentSpacer Width="10"></FluentSpacer>
                <FluentButton Appearance="Appearance.Lightweight"
                              IconStart="@(new Icons.Regular.Size20.ArrowSwap())"
                              OnClick="ChangeProject">
                    Change Project
                </FluentButton>
            }
            <FluentSpacer></FluentSpacer>
            @if (!string.IsNullOrEmpty(UserSession.UserEmail))
            {
                    <span style="font-size: 14px;">@UserSession.UserEmail</span>
                    <FluentSpacer Width="10"></FluentSpacer>
                    <FluentButton Appearance="Appearance.Lightweight" 
                                  IconStart="@(new Icons.Regular.Size20.SignOut())"
                                  OnClick="Logout">
                        Logout
                    </FluentButton>
            }
            else
            {
                    <FluentButton Appearance="Appearance.Lightweight" 
                                  IconStart="@(new Icons.Regular.Size20.Person())"
                                  OnClick="Login">
                        Sign In
                    </FluentButton>
            }
    </FluentHeader>
    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <NavMenu />
        <FluentBodyContent Class="body-content">
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>
    <FluentFooter>
        <a href="https://get-started.aps.autodesk.com/" target="_blank">APS Tutorials</a>
        <FluentSpacer />
        <a href="https://aps.autodesk.com/" target="_blank">About Autodesk Platform Services</a>
    </FluentFooter>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private SelectedProjectRecord? _selectedProject;

    protected override async Task OnInitializedAsync()
    {
        if (UserSession.IsAuthenticated)
        {
            _selectedProject = await SelectedProjectService.GetSelectedProjectAsync(UserSession.UserId ?? string.Empty);
        }
    }

    private void Login()
    {
        NavigationManager.NavigateTo("/api/auth/login?returnUrl=/", forceLoad: true);
    }

    private void Logout()
    {
        UserSession.ClearSession();
        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    private void ChangeProject()
    {
        NavigationManager.NavigateTo("/projects");
    }
}

