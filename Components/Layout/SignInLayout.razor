@inherits LayoutComponentBase

<div class="signin-shell">
    <div class="signin-appbar">
        <span class="signin-appbar-title">APS .NET Blazor Samples</span>
        <FluentAnchor Appearance="Appearance.Hypertext" Href="https://github.com/autodesk-platform-services/aps-dotnet-blazor-samples" Target="_blank" Rel="noopener noreferrer" Class="signin-help-link">
            <FluentIcon Value="@(new Icons.Regular.Size20.QuestionCircle())" Color="Color.Custom" CustomColor="#ffffff" />
            Help
        </FluentAnchor>
    </div>
    <div class="signin-body">
        @Body
    </div>
    <div class="signin-footer">
        <span>&copy; @DateTime.UtcNow.Year Autodesk Platform Services</span>
        <FluentAnchor Appearance="Appearance.Hypertext" Href="https://aps.autodesk.com/developer/documentation" Target="_blank" Rel="noopener noreferrer" Class="signin-footer-link">Documentation</FluentAnchor>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
