@inherits LayoutComponentBase

<div class="signin-shell">
    <div class="signin-appbar">
        <span class="signin-appbar-title">APS .NET Blazor Samples</span>
        <a href="https://github.com/autodesk-platform-services/aps-dotnet-blazor-samples" target="_blank" rel="noopener noreferrer" class="signin-help-link">
            <FluentIcon Value="@(new Icons.Regular.Size20.QuestionCircle())" Color="Color.Fill" CustomColor="#ffffff" />
            Help
        </a>
    </div>
    <div class="signin-body">
        @Body
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
