@using ApsSamples.Services
@inject IUserSessionService UserSession

<div class="navmenu">
    <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon" />
    <label for="navmenu-toggle" class="navmenu-icon"><FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Fill" /></label>
    <nav class="sitenav" aria-labelledby="main-menu">
        <FluentNavMenu Id="main-menu" Collapsible="true" Width="250" Title="Navigation menu" @bind-Expanded="expanded" CustomToggle="true">
            <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Icons.Regular.Size20.Home())" IconColor="Color.Accent">Home</FluentNavLink>
            @if (UserSession.IsAuthenticated)
            {
                <FluentNavLink Href="create-models-projects" Icon="@(new Icons.Regular.Size20.DocumentAdd())" IconColor="Color.Accent">Create Revit Models</FluentNavLink>
                <FluentNavLink Href="manage-links-projects" Icon="@(new Icons.Regular.Size20.Link())" IconColor="Color.Accent">Manage Revit Links</FluentNavLink>
                <FluentNavLink Href="create-sheets-projects" Icon="@(new Icons.Regular.Size20.DocumentMultiple())" IconColor="Color.Accent">Create Sheets</FluentNavLink>
                <FluentNavLink Href="view-models-projects" Icon="@(new Icons.Regular.Size20.Eye())" IconColor="Color.Accent">View Models</FluentNavLink>
            }
        </FluentNavMenu>
    </nav>
</div>

@code {
    private bool expanded = true;
}
