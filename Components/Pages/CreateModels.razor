    private async Task CreateAllModels()
    {
        try
        {
            _errorMessage = null;

            if (_modelsToCreate == null || !_modelsToCreate.Any())
            {
                _errorMessage = "No models to create";
                return;
            }

            if (string.IsNullOrEmpty(_selectedTemplateItemId) || _selectedTemplateModelGuid == Guid.Empty)
            {
                _errorMessage = "Please select a template";
                return;
            }

            if (string.IsNullOrEmpty(_selectedFolderId))
            {
                _errorMessage = "Please select a target folder";
                return;
            }

            var successCount = 0;
            var failedModels = new List<string>();

            // Submit a separate workitem for each model - each is completely independent
            foreach (var model in _modelsToCreate)
            {
                var result = await RevitAutomationTools.CreateModel(
                    _region ?? "US",
                    _projectGuid.ToString(),
                    _accountId,
                    _projectIdGuid,
                    _selectedFolderId,
                    _selectedTemplateName ?? string.Empty,
                    _selectedTemplateModelGuid.ToString(),
                    _enableWorksharing,
                    model.ModelName);

                if (result.IsSuccess)
                {
                    // Store individual creation job details - no batch grouping
                    CreationJobStatusService.StoreCreationJobDetails(
                        workItemId: result.WorkItemId!,
                        projectId: _projectId!,
                        projectName: _projectName ?? "Unknown Project",
                        userName: UserSession.UserName ?? UserSession.UserEmail ?? "Unknown User",
                        modelName: model.ModelName);

                    // Update the initial status
                    CreationJobStatusService.UpdateStatus(
                        workItemId: result.WorkItemId!,
                        status: result.Status ?? "pending",
                        reportUrl: null);

                    successCount++;
                }
                else
                {
                    failedModels.Add(model.ModelName);
                }
            }

            if (successCount > 0)
            {
                // Clear the models list after successful submission
                _modelsToCreate.Clear();

                if (failedModels.Any())
                {
                    _errorMessage = $"Successfully submitted {successCount} workitem(s). Failed: {string.Join(", ", failedModels)}";
                }

                // Navigate to model creation tracking page to show the jobs
                NavigationManager.NavigateTo($"/{_projectId}/model-creation-tracking");
            }
            else
            {
                _errorMessage = $"Failed to create workitems for all models: {string.Join(", ", failedModels)}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error creating models: {ex.Message}";
        }
    }

    // Naming Standard Dialog Methods
    private void ShowNamingStandardDialog()
    {
        if (_folderNamingStandard?.Definition?.Fields == null)
        {
            Console.WriteLine("Cannot show naming standard dialog: no fields defined");
            return;
        }

        _namingStandardFieldValues.Clear();
        _generatedNamesPreview.Clear();

        // Initialize field values with defaults - ensure ALL fields have a key
        foreach (var field in _folderNamingStandard.Definition.Fields)
        {
            var fieldKey = field.Name ?? string.Empty;
            if (!string.IsNullOrEmpty(fieldKey))
            {
                _namingStandardFieldValues[fieldKey] = field.DefaultValue ?? string.Empty;
                Console.WriteLine($"Initialized field '{fieldKey}' with default value: '{field.DefaultValue ?? "(empty)"}'");
            }
        }

        Console.WriteLine($"Naming standard dialog initialized with {_namingStandardFieldValues.Count} fields");
        
        _hideNamingStandardDialog = false;
        StateHasChanged();
    }

    private void CloseNamingStandardDialog()
    {
        _hideNamingStandardDialog = true;
        _generatedNamesPreview.Clear();
        // Don't clear _namingStandardFieldValues here to preserve values if user reopens
        StateHasChanged();
    }

    private void PreviewGeneratedNames()
    {
        if (_folderNamingStandard == null) return;

        _generatedNamesPreview.Clear();

        // Generate model name from single field values
        var modelName = NamingStandardsService.GenerateModelName(_folderNamingStandard, _namingStandardFieldValues);
        if (!string.IsNullOrEmpty(modelName))
        {
            _generatedNamesPreview.Add(modelName);
        }

        StateHasChanged();
    }

    private void AddGeneratedModels()
    {
        foreach (var modelName in _generatedNamesPreview)
        {
            // Check if model with same name already exists
            if (!_modelsToCreate.Any(m => m.ModelName.Equals(modelName, StringComparison.OrdinalIgnoreCase)))
            {
                _modelsToCreate.Add(new ModelToCreate { ModelName = modelName });
            }
        }

        _hideNamingStandardDialog = true;
        _generatedNamesPreview.Clear();
        StateHasChanged();
    }

    // Helper methods for naming standard dialog
    private string GetFieldPlaceholder(NamingStandardField field)
    {
        if (!string.IsNullOrEmpty(field.DefaultValue))
        {
            return $"Default: {field.DefaultValue}";
        }

        if (field.Options != null && field.Options.Any())
        {
            return field.Optional ? "Select an option" : "Select an option (required)";
        }

        return "Enter a value";
    }

    private string GetOptionText(NamingStandardFieldOption option)
    {
        if (string.IsNullOrEmpty(option.Description))
        {
            return option.Value ?? string.Empty;
        }

        return $"{option.Value} - {option.Description}";
    }

    private Icon GetFieldIcon(string? fieldType)
    {
        return fieldType?.ToUpperInvariant() switch
        {
            "ALPHANUMERIC" => new Icons.Regular.Size16.TextDescription(),
            "NUMERIC" => new Icons.Regular.Size16.NumberSymbol(),
            "ARRAY" => new Icons.Regular.Size16.List(),
            "CLASSIFICATION" => new Icons.Regular.Size16.Tag(),
            _ => new Icons.Regular.Size16.TextDescription()
        };
    }
