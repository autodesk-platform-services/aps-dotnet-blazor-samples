    private async Task ShowTemplateSelector()
    {
        await LoadAvailableTemplates();
        _hideTemplateSelectorDialog = false;
        StateHasChanged();
    }

    private async Task LoadAvailableTemplates()
    {
        try
        {
            _isLoadingTemplates = true;
            _availableTemplates = new List<TemplateInfo>();
            StateHasChanged();

            var folders = await DataManagementClient.GetProjectTopFoldersAsync(
                accessToken: UserSession.AccessToken,
                hubId: _hubId!,
                projectId: _projectId!);

            if (folders.Data != null)
            {
                foreach (var folder in folders.Data)
                {
                    await FindRevitModels(folder.Id ?? string.Empty);
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading templates: {ex.Message}";
        }
        finally
        {
            _isLoadingTemplates = false;
            StateHasChanged();
        }
    }

    private async Task FindRevitModels(string folderId)
    {
        try
        {
            var contents = await DataManagementClient.GetFolderContentsAsync(
                accessToken: UserSession.AccessToken,
                projectId: _projectId!,
                folderId: folderId);

            if (contents.Data != null)
            {
                // Create a dictionary of version details from the included section for fast lookup
                var versionDetailsDict = new Dictionary<string, dynamic>();

                if (contents.Included != null)
                {
                    foreach (var includedItem in contents.Included)
                    {
                        if (includedItem is VersionData versionData && versionData.Id != null)
                        {
                            versionDetailsDict[versionData.Id] = versionData;
                        }
                    }
                }

                foreach (var item in contents.Data)
                {
                    if (item is FolderData folderData)
                    {
                        await FindRevitModels(folderData.Id ?? string.Empty);
                    }
                    else if (item is ItemData itemData)
                    {
                        var displayName = itemData.Attributes?.DisplayName ?? "Unknown";

                        if (displayName.EndsWith(".rvt", StringComparison.OrdinalIgnoreCase))
                        {
                            var versionId = itemData.Relationships?.Tip?.Data?.Id ?? string.Empty;

                            if (!string.IsNullOrEmpty(versionId) && versionDetailsDict.TryGetValue(versionId, out var versionData))
                            {
                                // Check if it's a valid template using the included version data
                                var (isValid, modelGuid, projectGuid) = IsValidTemplateFromVersionData(versionData as VersionData, versionId);

                                if (isValid)
                                {
                                    _availableTemplates!.Add(new TemplateInfo
                                    {
                                        ModelName = displayName,
                                        ItemId = itemData.Id ?? string.Empty,
                                        VersionId = versionId,
                                        ModelGuid = modelGuid,
                                        ProjectGuid = projectGuid
                                    });
                                }
                            }
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error finding models in folder {folderId}: {ex.Message}");
        }
    }

    private (bool isValid, Guid modelGuid, string? projectGuid) IsValidTemplateFromVersionData(VersionData? versionData, string versionId)
    {
        if (versionData?.Attributes?.Extension == null)
        {
            Console.WriteLine($"Version {versionId} has no extension data");
            return (false, Guid.Empty, null);
        }

        var extension = versionData.Attributes.Extension;

        // Check if it's a C4R Model (cloud model)
        var extensionType = extension.Type?.ToString() ?? string.Empty;
        if (!extensionType.Equals("versions:autodesk.bim360:C4RModel", StringComparison.OrdinalIgnoreCase))
        {
            Console.WriteLine($"Version {versionId} is not a C4R Model. Type: {extensionType}");
            return (false, Guid.Empty, null);
        }

        // Check if extension data exists
        if (extension.Data == null)
        {
            Console.WriteLine($"Version {versionId} has no extension.data");
            return (false, Guid.Empty, null);
        }

        // Check if it's single-user (not workshared)
        if (extension.Data.TryGetValue("modelType", out var modelTypeObj))
        {
            var modelType = modelTypeObj?.ToString() ?? string.Empty;

            if (!modelType.Equals("singleuser", StringComparison.OrdinalIgnoreCase))
            {
                Console.WriteLine($"Version {versionId} is not single-user. ModelType: {modelType}");
                return (false, Guid.Empty, null);
            }
        }
        else
        {
            Console.WriteLine($"Version {versionId} has no modelType property");
            return (false, Guid.Empty, null);
        }

        // Extract ModelGuid
        Guid modelGuid = Guid.Empty;
        if (extension.Data.TryGetValue("modelGuid", out var modelGuidObj))
        {
            if (Guid.TryParse(modelGuidObj?.ToString(), out var parsedGuid))
            {
                modelGuid = parsedGuid;
            }
        }

        // Extract ProjectGuid
        string? projectGuid = null;
        if (extension.Data.TryGetValue("projectGuid", out var projectGuidObj))
        {
            projectGuid = projectGuidObj?.ToString();
        }

        Console.WriteLine($"Version {versionId} is a valid single-user template");
        Console.WriteLine($"  ModelGuid: {modelGuid}");
        Console.WriteLine($"  ProjectGuid: {projectGuid}");
        
        return (true, modelGuid, projectGuid);
    }

    private void SelectTemplate(TemplateInfo template)
    {
        _selectedTemplateName = template.ModelName;
        _selectedTemplateItemId = template.ItemId;
        _selectedTemplateVersionId = template.VersionId;
        _selectedTemplateModelGuid = template.ModelGuid;
        
        // Get ProjectGuid from template
        if (!string.IsNullOrEmpty(template.ProjectGuid) && Guid.TryParse(template.ProjectGuid, out var projectGuid))
        {
            _projectGuid = projectGuid;
            Console.WriteLine($"ProjectGuid set from template: {_projectGuid}");
        }

        _hideTemplateSelectorDialog = true;
        StateHasChanged();
    }

