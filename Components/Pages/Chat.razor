@page "/{ProjectId}/chat"
@using ApsSamples.Models
@using ApsSamples.Services
@using Autodesk.Construction.AccountAdmin
@using Markdig
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.FluentUI.AspNetCore.Components
@inject IUserSessionService UserSession
@inject IProjectRoleService RoleService
@inject IAgentChatService ChatService
@inject IAgentConversationService ConversationService
@inject IAgentTaskService TaskService
@inject AdminClient AdminClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>AI Assistants - @(_projectName ?? "Chat")</PageTitle>

<style>
    .chat-message-bubble {
        max-width: 80%;
        padding: 10px 14px;
        border-radius: 12px;
        word-wrap: break-word;
    }

    .chat-user-bubble {
        background: var(--accent-fill-rest);
        color: var(--foreground-on-accent-rest);
        align-self: flex-end;
        border-bottom-right-radius: 4px;
        white-space: pre-wrap;
    }

    .chat-assistant-bubble {
        background: var(--neutral-layer-3);
        color: var(--neutral-foreground-rest);
        align-self: flex-start;
        border-bottom-left-radius: 4px;
    }

    .chat-assistant-bubble > :first-child {
        margin-top: 0;
    }

    .chat-assistant-bubble > :last-child {
        margin-bottom: 0;
    }

    .chat-assistant-bubble pre {
        background: var(--neutral-layer-2);
        border-radius: 6px;
        padding: 8px 10px;
        overflow-x: auto;
    }

    .chat-assistant-bubble code {
        font-family: var(--body-font, monospace);
        background: var(--neutral-layer-2);
        border-radius: 4px;
        padding: 1px 4px;
    }

    .chat-assistant-bubble pre code {
        background: none;
        padding: 0;
    }

    .chat-assistant-bubble table {
        border-collapse: collapse;
    }

    .chat-assistant-bubble th,
    .chat-assistant-bubble td {
        border: 1px solid var(--neutral-stroke-rest);
        padding: 4px 8px;
    }

    .chat-message-row {
        display: flex;
        flex-direction: column;
        margin-bottom: 12px;
    }

    .chat-message-timestamp {
        font-size: 11px;
        color: var(--neutral-foreground-hint);
        margin-top: 3px;
    }

    .chat-columns {
        align-items: flex-start;
        height: 75vh;
    }

    @@media (max-width: 768px) {
        .chat-columns {
            flex-direction: column !important;
            height: auto !important;
        }
        .chat-side-panel,
        .chat-task-panel {
            width: 100% !important;
            flex: 0 0 auto !important;
            max-height: 300px;
        }
    }

    .conversation-item {
        width: 100%;
        box-sizing: border-box;
        cursor: pointer;
        padding: 8px;
        border-radius: 6px;
        border: 1px solid transparent;
    }

    .conversation-item:hover {
        background: var(--neutral-layer-2);
    }

    .conversation-item-active {
        background: var(--neutral-layer-2);
        border-color: var(--accent-fill-rest);
    }

    .conversation-title {
        font-size: 13px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .conversation-timestamp {
        font-size: 11px;
        color: var(--neutral-foreground-hint);
        margin-top: 2px;
    }

    .task-item {
        width: 100%;
        box-sizing: border-box;
        cursor: pointer;
        border: 1px solid var(--neutral-stroke-rest);
        border-radius: 6px;
        padding: 8px;
    }

    .task-item:hover {
        background: var(--neutral-layer-2);
    }

    .task-item summary {
        list-style: none;
    }

    .task-item summary::-webkit-details-marker {
        display: none;
    }

    .task-status-badge {
        color: white;
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 11px;
    }
</style>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
    <FluentButton Appearance="Appearance.Lightweight"
                  IconStart="@(new Icons.Regular.Size20.ArrowLeft())"
                  OnClick="@(() => NavigationManager.NavigateTo("/chat-projects"))">
        Back to Projects
    </FluentButton>

    <div>
        <h1>AI Assistants Chat</h1>
        @if (!string.IsNullOrEmpty(_projectName))
        {
            <p style="color: var(--neutral-foreground-hint); margin: 5px 0 0 0;">
                Project: @_projectName
            </p>
        }
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Error">
            @_errorMessage
        </FluentMessageBar>
    }
    else if (_conversation != null)
    {
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Class="chat-columns">
            <FluentStack Orientation="Orientation.Vertical"
                         VerticalGap="8"
                         Class="chat-side-panel"
                         Style="width: 260px; flex: 0 0 260px; overflow-y: auto; height: 100%;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <h3 style="margin: 0;">Conversations</h3>
                    <FluentButton Appearance="Appearance.Lightweight"
                                  IconStart="@(new Icons.Regular.Size16.Add())"
                                  Title="New conversation"
                                  OnClick="StartNewConversationAsync" />
                </div>
                @foreach (var convo in _conversations)
                {
                    <div class="conversation-item @(convo.ConversationId == _conversation.ConversationId ? "conversation-item-active" : "")"
                         @onclick="@(() => SelectConversationAsync(convo))">
                        <div class="conversation-title">@GetConversationTitle(convo)</div>
                        <div class="conversation-timestamp">@convo.LastActivityAt.ToLocalTime().ToString("g")</div>
                    </div>
                }
            </FluentStack>

            <div style="flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; height: 100%; border: 1px solid var(--neutral-stroke-rest); border-radius: 6px;">
                <div style="flex: 1 1 auto; overflow-y: auto; padding: 12px; display: flex; flex-direction: column;">
                    @if (_conversation.Messages.Count == 0)
                    {
                        <p style="color: var(--neutral-foreground-hint); text-align: center; margin-top: 40px;">
                            Start a conversation by typing a message below.
                        </p>
                    }
                    else
                    {
                        @foreach (var msg in _conversation.Messages)
                        {
                            var isUser = string.Equals(msg.Role, "user", StringComparison.OrdinalIgnoreCase);
                            <div id="msg-@msg.Id" class="chat-message-row" style="align-items: @(isUser ? "flex-end" : "flex-start");">
                                <div class="chat-message-bubble @(isUser ? "chat-user-bubble" : "chat-assistant-bubble")">
                                    @if (isUser)
                                    {
                                        @msg.Content
                                    }
                                    else
                                    {
                                        @RenderMarkdown(msg.Content)
                                    }
                                </div>
                                <div class="chat-message-timestamp">@msg.Timestamp.ToLocalTime().ToString("t")</div>
                            </div>
                        }
                    }
                    <div @ref="_scrollAnchor"></div>
                </div>

                <div style="padding: 12px; border-top: 1px solid var(--neutral-stroke-rest);">
                    <FluentTextArea @bind-Value="_inputText"
                                    Immediate="true"
                                    Placeholder="Type a message..."
                                    Rows="3"
                                    Style="width: 100%;"
                                    Disabled="_isStreaming"
                                    @onkeydown="HandleKeyDown" />
                    <FluentStack Orientation="Orientation.Horizontal"
                                 HorizontalAlignment="HorizontalAlignment.End"
                                 VerticalAlignment="VerticalAlignment.Center"
                                 HorizontalGap="8"
                                 Style="margin-top: 8px;">
                        @if (_isStreaming)
                        {
                            <FluentProgressRing Style="width: 20px; height: 20px;" />
                            <span style="color: var(--neutral-foreground-hint);">Responding...</span>
                        }
                        <FluentButton Appearance="Appearance.Accent"
                                      IconStart="@(new Icons.Regular.Size16.Send())"
                                      OnClick="SendMessage"
                                      Disabled="@(_isStreaming || string.IsNullOrWhiteSpace(_inputText))">
                            Send
                        </FluentButton>
                    </FluentStack>
                </div>
            </div>

            <FluentStack Orientation="Orientation.Vertical"
                         VerticalGap="8"
                         Class="chat-task-panel"
                         Style="width: 360px; flex: 0 0 360px; overflow-y: auto; height: 100%;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <h3 style="margin: 0;">Assistant Tasks</h3>
                    @if (_taskFilterConversationId != null)
                    {
                        <FluentButton Appearance="Appearance.Hypertext" OnClick="ClearTaskFilter">
                            Show all
                        </FluentButton>
                    }
                </div>
                @if (FilteredTasks.Count == 0)
                {
                    <p style="color: var(--neutral-foreground-hint);">No tasks yet.</p>
                }
                else
                {
                    @foreach (var task in FilteredTasks)
                    {
                        <details class="task-item" @onclick="@(() => SelectTaskAsync(task))">
                            <summary style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                <span style="flex: 1 1 auto;">@task.Name</span>
                                <span class="task-status-badge" style="@GetTaskBadgeStyle(task.Status)">
                                    @task.Status
                                </span>
                            </summary>
                            <div style="margin-top: 8px; font-size: 12px;">
                                <div>Started: @task.StartedAt.ToLocalTime().ToString("g")</div>
                                @if (task.CompletedAt.HasValue)
                                {
                                    <div>Completed: @task.CompletedAt.Value.ToLocalTime().ToString("g")</div>
                                }
                                @if (!string.IsNullOrEmpty(task.ProgressDetail))
                                {
                                    <div style="margin-top: 4px;">@task.ProgressDetail</div>
                                }
                                @if (task.Status == AgentTaskStatus.Failed && !string.IsNullOrEmpty(task.ErrorDetail))
                                {
                                    <div style="margin-top: 4px; color: var(--error);">@task.ErrorDetail</div>
                                }
                            </div>
                        </details>
                    }
                }
            </FluentStack>
        </FluentStack>
    }
</FluentStack>

@code {
    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private static MarkupString RenderMarkdown(string content) =>
        (MarkupString)Markdown.ToHtml(content, MarkdownPipeline);

    [Parameter]
    public string? ProjectId { get; set; }

    private string? _projectName;
    private string? _errorMessage;
    private string? _userId;
    private ConversationSession? _conversation;
    private List<ConversationSession> _conversations = new();
    private IReadOnlyList<AgentTaskInfo> _agentTasks = Array.Empty<AgentTaskInfo>();
    private string? _taskFilterConversationId;
    private string _inputText = string.Empty;
    private bool _isStreaming;
    private bool _disposed;
    private System.Threading.Timer? _pollingTimer;
    private CancellationTokenSource _streamingCts = new();
    private ElementReference _scrollAnchor;
    private IJSObjectReference? _jsModule;

    private IReadOnlyList<AgentTaskInfo> FilteredTasks => _taskFilterConversationId == null
        ? _agentTasks
        : _agentTasks.Where(t => t.ConversationId == _taskFilterConversationId).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/chat-projects");
            return;
        }

        if (string.IsNullOrEmpty(ProjectId))
        {
            _errorMessage = "Project ID is required.";
            return;
        }

        // Give the agent's tools the project this page is scoped to, so the LLM never has to
        // supply (or guess) a project ID itself.
        ChatService.SetProjectContext(ProjectId);

        var accessToken = UserSession.AccessToken ?? string.Empty;
        var accountAdminUserId = UserSession.UserId ?? string.Empty;
        var isBimManager = await RoleService.IsBimManagerAsync(ProjectId, accountAdminUserId, accessToken);
        if (!isBimManager)
        {
            NavigationManager.NavigateTo("/chat-projects?error=unauthorized");
            return;
        }

        await LoadProjectNameAsync();

        _userId = UserSession.UserEmail ?? UserSession.UserName ?? "unknown";
        _conversations = (await ConversationService.GetConversationsAsync(ProjectId, _userId)).ToList();
        if (_conversations.Count == 0)
        {
            _conversations.Add(await ConversationService.CreateConversationAsync(ProjectId, _userId));
        }

        _conversation = _conversations[0];
        ChatService.SetConversationContext(_conversation.ConversationId);
        _taskFilterConversationId = _conversation.ConversationId;

        _agentTasks = await TaskService.GetTasksByProjectAsync(ProjectId);

        _pollingTimer = new System.Threading.Timer(async _ =>
        {
            if (_disposed || ProjectId == null) return;
            try
            {
                _agentTasks = await TaskService.GetTasksByProjectAsync(ProjectId);
                _conversations = _conversations.OrderByDescending(c => c.LastActivityAt).ToList();
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException) { }
            catch (Exception ex)
            {
                Console.WriteLine($"Task poll error: {ex.Message}");
            }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import",
                "./Components/Pages/Chat.razor.js");

            if (_conversation != null && _conversation.Messages.Count > 0)
            {
                await ScrollToBottomAsync();
            }
        }
    }

    private async Task LoadProjectNameAsync()
    {
        try
        {
            var accessToken = UserSession.AccessToken ?? string.Empty;

            // Account Admin project IDs drop the "b." hub prefix used by the Data Management API.
            var accountProjectId = ProjectId!.StartsWith("b.", StringComparison.OrdinalIgnoreCase)
                ? ProjectId[2..]
                : ProjectId;

            var project = await AdminClient.GetProjectAsync(projectId: accountProjectId, accessToken: accessToken);
            _projectName = project?.Name ?? "Unknown Project";

            // Give the agent's tools the hub this project belongs to, so they never have to
            // resolve it themselves via an extra API call.
            if (!string.IsNullOrEmpty(project?.AccountId))
            {
                ChatService.SetHubContext("b." + project.AccountId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading project name: {ex.Message}");
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
            _inputText = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendMessage()
    {
        if (_conversation == null || _isStreaming || string.IsNullOrWhiteSpace(_inputText))
            return;

        var text = _inputText.Trim();
        _inputText = string.Empty;

        var userMessage = new ConversationMessage
        {
            Role = "user",
            Content = text,
            Timestamp = DateTime.UtcNow
        };
        _conversation.Messages.Add(userMessage);
        await ConversationService.AddMessageAsync(_conversation.ConversationId, userMessage);

        var assistantMessage = new ConversationMessage
        {
            Role = "assistant",
            Content = string.Empty,
            Timestamp = DateTime.UtcNow
        };
        _conversation.Messages.Add(assistantMessage);

        _isStreaming = true;
        await InvokeAsync(StateHasChanged);
        await ScrollToBottomAsync();

        _streamingCts.Dispose();
        _streamingCts = new CancellationTokenSource();

        try
        {
            await foreach (var token in ChatService.StreamResponseAsync(_conversation.Messages, _streamingCts.Token))
            {
                assistantMessage.Content += token;
                await InvokeAsync(StateHasChanged);
                await ScrollToBottomAsync();
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            assistantMessage.Content = $"[Error: {ex.Message}]";
        }
        finally
        {
            assistantMessage.Timestamp = DateTime.UtcNow;
            await ConversationService.AddMessageAsync(_conversation.ConversationId, assistantMessage);
            _conversations = _conversations.OrderByDescending(c => c.LastActivityAt).ToList();
            _isStreaming = false;
            await InvokeAsync(StateHasChanged);
            await ScrollToBottomAsync();
        }
    }

    private async Task StartNewConversationAsync()
    {
        if (ProjectId == null || _userId == null) return;

        var created = await ConversationService.CreateConversationAsync(ProjectId, _userId);
        _conversations.Insert(0, created);
        await SelectConversationAsync(created);
    }

    private async Task SelectConversationAsync(ConversationSession convo)
    {
        _conversation = convo;
        _taskFilterConversationId = convo.ConversationId;
        ChatService.SetConversationContext(convo.ConversationId);
        await InvokeAsync(StateHasChanged);
        await ScrollToBottomAsync();
    }

    private void ClearTaskFilter()
    {
        _taskFilterConversationId = null;
    }

    private async Task SelectTaskAsync(AgentTaskInfo task)
    {
        var convo = _conversations.FirstOrDefault(c => c.ConversationId == task.ConversationId);
        if (convo != null && convo != _conversation)
        {
            _conversation = convo;
            ChatService.SetConversationContext(convo.ConversationId);
        }

        await InvokeAsync(StateHasChanged);

        if (!string.IsNullOrEmpty(task.RelatedMessageId))
        {
            await ScrollToMessageAsync(task.RelatedMessageId);
        }
        else
        {
            await ScrollToBottomAsync();
        }
    }

    private static string GetConversationTitle(ConversationSession convo)
    {
        var firstUserMessage = convo.Messages
            .FirstOrDefault(m => string.Equals(m.Role, "user", StringComparison.OrdinalIgnoreCase));

        if (firstUserMessage == null || string.IsNullOrWhiteSpace(firstUserMessage.Content))
        {
            return "New conversation";
        }

        var text = firstUserMessage.Content.Trim();
        return text.Length > 40 ? text[..40] + "…" : text;
    }

    private async Task ScrollToBottomAsync()
    {
        if (_jsModule == null) return;
        try
        {
            await _jsModule.InvokeVoidAsync("scrollIntoView", _scrollAnchor);
        }
        catch (JSDisconnectedException) { }
        catch (Exception) { }
    }

    private async Task ScrollToMessageAsync(string messageId)
    {
        if (_jsModule == null) return;
        try
        {
            await _jsModule.InvokeVoidAsync("scrollToElementById", $"msg-{messageId}");
        }
        catch (JSDisconnectedException) { }
        catch (Exception) { }
    }

    private static string GetTaskBadgeStyle(AgentTaskStatus status) => status switch
    {
        AgentTaskStatus.Completed => "background-color: #107c10;",
        AgentTaskStatus.Running => "background-color: #ca5010;",
        AgentTaskStatus.Pending => "background-color: #ca5010;",
        AgentTaskStatus.Failed => "background-color: #d13438;",
        _ => "background-color: #797775;"
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _pollingTimer?.Dispose();
        try
        {
            _streamingCts.Cancel();
        }
        catch (ObjectDisposedException) { }
        _streamingCts.Dispose();

        if (_jsModule != null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }
}
