@page "/chat"
@using ApsSamples.Models
@using ApsSamples.Services
@using Markdig
@using Microsoft.FluentUI.AspNetCore.Components
@inject IUserSessionService UserSession
@inject IProjectRoleService RoleService
@inject IAgentChatService ChatService
@inject IAgentConversationService ConversationService
@inject IAgentTaskService TaskService
@inject IAgentRegistryService AgentRegistryService
@inject ISelectedProjectService SelectedProjectService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>AI Assistants - @(_projectName ?? "Chat")</PageTitle>

<style>
    .chat-message-bubble {
        max-width: 80%;
        padding: 10px 14px;
        border-radius: 12px;
        word-wrap: break-word;
    }

    .chat-user-bubble {
        background: var(--accent-fill-rest);
        color: var(--foreground-on-accent-rest);
        align-self: flex-end;
        border-bottom-right-radius: 4px;
        white-space: pre-wrap;
    }

    .chat-assistant-bubble {
        background: var(--neutral-layer-3);
        color: var(--neutral-foreground-rest);
        align-self: flex-start;
        border-bottom-left-radius: 4px;
    }

    .chat-assistant-bubble > :first-child {
        margin-top: 0;
    }

    .chat-assistant-bubble > :last-child {
        margin-bottom: 0;
    }

    .chat-assistant-bubble pre {
        background: var(--neutral-layer-2);
        border-radius: 6px;
        padding: 8px 10px;
        overflow-x: auto;
    }

    .chat-assistant-bubble code {
        font-family: var(--body-font, monospace);
        background: var(--neutral-layer-2);
        border-radius: 4px;
        padding: 1px 4px;
    }

    .chat-assistant-bubble pre code {
        background: none;
        padding: 0;
    }

    .chat-assistant-bubble table {
        border-collapse: collapse;
    }

    .chat-assistant-bubble th,
    .chat-assistant-bubble td {
        border: 1px solid var(--neutral-stroke-rest);
        padding: 4px 8px;
    }

    .chat-notice-bubble {
        border-radius: 8px;
        border: 1px solid;
        padding: 10px 14px;
        align-self: flex-start;
        max-width: 80%;
    }

    .chat-notice-success {
        background: color-mix(in srgb, #107c10 12%, transparent);
        border-color: #107c10;
    }

    .chat-notice-failure {
        background: color-mix(in srgb, #d13438 12%, transparent);
        border-color: #d13438;
    }

    .chat-avatar {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--accent-fill-rest);
        color: var(--foreground-on-accent-rest);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 600;
        flex: 0 0 auto;
    }

    .chat-message-row {
        display: flex;
        flex-direction: column;
        margin-bottom: 12px;
    }

    .chat-message-row-assistant {
        flex-direction: row;
        align-items: flex-start;
        gap: 8px;
    }

    .chat-message-timestamp {
        font-size: 11px;
        color: var(--neutral-foreground-hint);
        margin-top: 3px;
    }

    .chat-columns {
        align-items: flex-start;
        /* Kept well under 100vh (header + the extra project-name row above this, plus the
           app footer below it, already take up real space) so the footer stays on screen
           instead of being pushed below the fold. */
        height: 85vh;
    }

    @@media (max-width: 768px) {
        .chat-columns {
            flex-direction: column !important;
            height: auto !important;
        }
        .chat-side-panel,
        .chat-task-panel {
            width: 100% !important;
            flex: 0 0 auto !important;
            max-height: 300px;
        }
    }

    .chat-center-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 12px 16px;
        border-bottom: 1px solid var(--neutral-stroke-rest);
        gap: 8px;
    }

    .chat-quick-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 0 12px 8px 12px;
    }

    .chat-quick-action-chip {
        cursor: pointer;
        font-size: 12px;
        padding: 5px 12px;
        border-radius: 999px;
        border: 1px solid var(--neutral-stroke-rest);
        background: var(--neutral-layer-1);
        color: var(--neutral-foreground-rest);
    }

    .chat-quick-action-chip:hover {
        background: var(--neutral-layer-2);
    }

    .chat-input-hint {
        font-size: 11px;
        color: var(--neutral-foreground-hint);
        margin-top: 4px;
    }

    .panel-group-label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--neutral-foreground-hint);
        text-transform: uppercase;
        margin: 4px 0 0 0;
    }

    .conversation-item {
        width: 100%;
        box-sizing: border-box;
        cursor: pointer;
        padding: 8px;
        border-radius: 6px;
        border: 1px solid transparent;
        border-left: 3px solid transparent;
    }

    .conversation-item:hover {
        background: var(--neutral-layer-2);
    }

    .conversation-item-active {
        background: var(--neutral-layer-2);
        border-left-color: var(--accent-fill-rest);
    }

    .conversation-title-row {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .conversation-title {
        font-size: 13px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .conversation-active-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #107c10;
        flex: 0 0 auto;
    }

    .conversation-meta {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: var(--neutral-foreground-hint);
        margin-top: 2px;
    }

    .task-counts-row {
        display: flex;
        gap: 12px;
        font-size: 12px;
        color: var(--neutral-foreground-hint);
        flex-wrap: wrap;
    }

    .task-filter-tabs {
        display: flex;
        gap: 4px;
        border-bottom: 1px solid var(--neutral-stroke-rest);
        padding-bottom: 4px;
    }

    .task-filter-tab {
        cursor: pointer;
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 6px;
        color: var(--neutral-foreground-hint);
    }

    .task-filter-tab:hover {
        background: var(--neutral-layer-2);
    }

    .task-filter-tab-active {
        background: var(--neutral-layer-2);
        color: var(--neutral-foreground-rest);
        font-weight: 600;
    }

    .task-item {
        width: 100%;
        box-sizing: border-box;
        cursor: pointer;
        border: 1px solid var(--neutral-stroke-rest);
        border-left: 3px solid var(--neutral-stroke-rest);
        border-radius: 6px;
        padding: 8px;
    }

    .task-item:hover {
        background: var(--neutral-layer-2);
    }

    .task-item summary {
        list-style: none;
    }

    .task-item summary::-webkit-details-marker {
        display: none;
    }

    .task-item-active {
        border-left-color: #ca5010;
    }

    .task-item-completed {
        border-left-color: #107c10;
    }

    .task-item-failed {
        border-left-color: #d13438;
    }

    .task-status-badge {
        color: white;
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 11px;
    }
</style>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
    <div style="display: flex; align-items: center; gap: 16px;">
        @if (!string.IsNullOrEmpty(_projectName))
        {
            <span style="color: var(--neutral-foreground-hint); font-weight: 600;">@_projectName</span>
        }
        @if (_agentLocked && _selectedAgent != null)
        {
            <span style="color: var(--neutral-foreground-hint);">Chatting with: <strong>@_selectedAgent.AgentName</strong></span>
        }
    </div>

    @if (_accessDenied)
    {
        <FluentMessageBar Intent="MessageIntent.Warning">
            Access denied. You do not have the BIM Manager role for this project.
        </FluentMessageBar>
    }
    else if (_noAgentsAccessible)
    {
        <FluentMessageBar Intent="MessageIntent.Warning">
            No agents are configured for your role. Contact your project admin.
        </FluentMessageBar>
    }
    else if (!_agentLocked && _accessibleAgents.Count > 1)
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="padding: 24px; max-width: 480px;">
            <h3 style="margin: 0;">Select an assistant to start a conversation</h3>
            <p style="color: var(--neutral-foreground-hint); margin: 0;">
                Once started, this conversation is locked to the assistant you pick.
            </p>
            <FluentSelect TOption="AgentDefinition"
                          Items="@_accessibleAgents"
                          OptionText="@(a => $"{a.AgentName} ({a.RoleName})")"
                          OptionValue="@(a => a.AgentId)"
                          @bind-SelectedOption="_selectedAgent"
                          Style="width: 100%;" />
            <FluentButton Appearance="Appearance.Accent"
                          Disabled="@(_selectedAgent == null)"
                          OnClick="OnAgentSelectedAsync">
                Start Conversation
            </FluentButton>
        </FluentStack>
    }
    else if (_conversation != null)
    {
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0" Class="chat-columns">
            <FluentStack Orientation="Orientation.Vertical"
                         VerticalGap="8"
                         Class="chat-side-panel"
                         Style="width: 260px; flex: 0 0 260px; overflow-y: auto; height: 100%; border-right: 1px solid var(--neutral-stroke-rest); padding-right: 10px;">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <h3 style="margin: 0;">Conversations</h3>
                </div>
                <FluentButton Appearance="Appearance.Accent"
                              IconStart="@(new Icons.Regular.Size16.Add())"
                              Style="width: 100%;"
                              OnClick="StartNewConversationAsync">
                    New conversation
                </FluentButton>
                <FluentSearch @bind-Value="_conversationSearch"
                              Immediate="true"
                              Placeholder="Search conversations..."
                              Style="width: 100%;" />
                @foreach (var group in GroupConversationsByDate(FilteredConversations))
                {
                    <p class="panel-group-label">@group.Label</p>
                    @foreach (var convo in group.Items)
                    {
                        <div class="conversation-item @(convo.ConversationId == _conversation.ConversationId ? "conversation-item-active" : "")"
                             @onclick="@(() => SelectConversationAsync(convo))">
                            <div class="conversation-title-row">
                                @if (HasActiveTask(convo.ConversationId))
                                {
                                    <span class="conversation-active-dot" title="Has an active task"></span>
                                }
                                <span class="conversation-title">@GetConversationTitle(convo)</span>
                            </div>
                            <div class="conversation-meta">
                                <span>@TaskCount(convo.ConversationId) task@(TaskCount(convo.ConversationId) == 1 ? "" : "s")</span>
                                <span>@convo.LastActivityAt.ToLocalTime().ToString("t")</span>
                            </div>
                        </div>
                    }
                }
            </FluentStack>

            <div style="flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; height: 100%;">
                <div class="chat-center-header">
                    <h2 style="margin: 0;">@GetConversationTitle(_conversation)</h2>
                    <FluentButton Appearance="Appearance.Lightweight" OnClick="ClearChatAsync">
                        Clear chat
                    </FluentButton>
                </div>

                <div style="flex: 1 1 auto; overflow-y: auto; padding: 12px; display: flex; flex-direction: column;">
                    @if (_conversation.Messages.Count == 0)
                    {
                        <p style="color: var(--neutral-foreground-hint); text-align: center; margin-top: 40px;">
                            Start a conversation by typing a message below.
                        </p>
                    }
                    else
                    {
                        @foreach (var msg in _conversation.Messages)
                        {
                            var isUser = string.Equals(msg.Role, "user", StringComparison.OrdinalIgnoreCase);
                            var isSuccessNotice = !isUser && msg.Content.StartsWith("✅");
                            var isFailureNotice = !isUser && msg.Content.StartsWith("⚠️");
                            <div id="msg-@msg.Id" class="chat-message-row @(isUser ? "" : "chat-message-row-assistant")" style="align-items: @(isUser ? "flex-end" : "flex-start");">
                                @if (!isUser)
                                {
                                    <div class="chat-avatar">A</div>
                                }
                                <div style="display: flex; flex-direction: column; align-items: @(isUser ? "flex-end" : "flex-start");">
                                    @if (isSuccessNotice || isFailureNotice)
                                    {
                                        <div class="chat-notice-bubble @(isSuccessNotice ? "chat-notice-success" : "chat-notice-failure")">
                                            @RenderMarkdown(msg.Content)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="chat-message-bubble @(isUser ? "chat-user-bubble" : "chat-assistant-bubble")">
                                            @if (isUser)
                                            {
                                                @msg.Content
                                            }
                                            else
                                            {
                                                @RenderMarkdown(msg.Content)
                                            }
                                        </div>
                                    }
                                    <div class="chat-message-timestamp">@msg.Timestamp.ToLocalTime().ToString("t")</div>
                                </div>
                            </div>
                        }
                    }
                    <div @ref="_scrollAnchor"></div>
                </div>

                <div class="chat-quick-actions">
                    <span class="chat-quick-action-chip" @onclick='@(() => SetQuickPrompt("List unpublished models in this project"))'>
                        Find unpublished models
                    </span>
                    <span class="chat-quick-action-chip" @onclick='@(() => SetQuickPrompt("List the Revit models in this project"))'>
                        List Revit models
                    </span>
                    @if (_agentTasks.Any(t => t.Status == AgentTaskStatus.Failed))
                    {
                        <span class="chat-quick-action-chip" @onclick="@(() => _taskStatusFilter = "Failed")">
                            Show failed tasks
                        </span>
                    }
                </div>

                <div style="padding: 12px; border-top: 1px solid var(--neutral-stroke-rest);">
                    <FluentTextArea @ref="_inputTextArea"
                                    @bind-Value="_inputText"
                                    Immediate="true"
                                    Placeholder="Ask about this project or request an action..."
                                    Rows="3"
                                    Style="width: 100%;"
                                    Disabled="_isStreaming" />
                    <FluentStack Orientation="Orientation.Horizontal"
                                 HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                                 VerticalAlignment="VerticalAlignment.Center"
                                 HorizontalGap="8"
                                 Style="margin-top: 8px;">
                        <span class="chat-input-hint">Enter to send &bull; Shift+Enter for new line</span>
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.SpaceBetween" HorizontalGap="8">
                            @if (_isStreaming)
                            {
                                <FluentProgressRing Style="width: 20px; height: 20px;" />
                                <span style="color: var(--neutral-foreground-hint);">Responding...</span>
                            }
                            <FluentButton Appearance="Appearance.Accent"
                                          IconStart="@(new Icons.Regular.Size16.Send())"
                                          OnClick="SendMessage"
                                          Disabled="@(_isStreaming || string.IsNullOrWhiteSpace(_inputText))">
                                Send
                            </FluentButton>
                        </FluentStack>
                    </FluentStack>
                </div>
            </div>

            <FluentStack Orientation="Orientation.Vertical"
                         VerticalGap="8"
                         Class="chat-task-panel"
                         Style="width: 360px; flex: 0 0 360px; overflow-y: auto; height: 100%; border-left: 1px solid var(--neutral-stroke-rest); padding-left: 10px;">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <h3 style="margin: 0;">Tasks</h3>
                    @if (_taskFilterConversationId != null)
                    {
                        <FluentButton Appearance="Appearance.Lightweight" OnClick="ClearTaskFilter">
                            Show all
                        </FluentButton>
                    }
                </div>

                <div class="task-counts-row">
                    <span>✅ @FilteredTasks.Count(t => t.Status == AgentTaskStatus.Completed) Completed</span>
                    <span>🟠 @FilteredTasks.Count(t => t.Status is AgentTaskStatus.Running or AgentTaskStatus.Pending) Active</span>
                    <span>❌ @FilteredTasks.Count(t => t.Status == AgentTaskStatus.Failed) Failed</span>
                </div>

                <div class="task-filter-tabs">
                    <span class="task-filter-tab @(_taskStatusFilter == null ? "task-filter-tab-active" : "")" @onclick="@(() => _taskStatusFilter = null)">All</span>
                    <span class="task-filter-tab @(_taskStatusFilter == "Active" ? "task-filter-tab-active" : "")" @onclick='@(() => _taskStatusFilter = "Active")'>Active</span>
                    <span class="task-filter-tab @(_taskStatusFilter == "Completed" ? "task-filter-tab-active" : "")" @onclick='@(() => _taskStatusFilter = "Completed")'>Completed</span>
                    <span class="task-filter-tab @(_taskStatusFilter == "Failed" ? "task-filter-tab-active" : "")" @onclick='@(() => _taskStatusFilter = "Failed")'>Failed</span>
                </div>

                @if (DisplayedTasks.Count == 0)
                {
                    <p style="color: var(--neutral-foreground-hint);">No tasks yet.</p>
                }
                else
                {
                    @foreach (var group in GroupTasksByStatus(DisplayedTasks))
                    {
                        <p class="panel-group-label">@group.Label</p>
                        @foreach (var task in group.Items)
                        {
                            <details class="task-item @GetTaskItemClass(task.Status)" @onclick="@(() => SelectTaskAsync(task))">
                                <summary style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                                    <span style="flex: 1 1 auto;">@task.Name</span>
                                    <span class="task-status-badge" style="@GetTaskBadgeStyle(task.Status)">
                                        @task.Status
                                    </span>
                                </summary>
                                <div style="margin-top: 8px; font-size: 12px;">
                                    <div>Started: @task.StartedAt.ToLocalTime().ToString("g")</div>
                                    @if (task.CompletedAt.HasValue)
                                    {
                                        <div>Completed: @task.CompletedAt.Value.ToLocalTime().ToString("g") (@FormatDuration(task.StartedAt, task.CompletedAt.Value))</div>
                                    }
                                    @if (!string.IsNullOrEmpty(task.ProgressDetail))
                                    {
                                        <div style="margin-top: 4px;">@task.ProgressDetail</div>
                                    }
                                    @if (task.Status == AgentTaskStatus.Failed && !string.IsNullOrEmpty(task.ErrorDetail))
                                    {
                                        <div style="margin-top: 4px; color: var(--error);">@task.ErrorDetail</div>
                                    }
                                </div>
                            </details>
                        }
                    }
                }
            </FluentStack>
        </FluentStack>
    }
</FluentStack>

@code {
    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private static MarkupString RenderMarkdown(string content) =>
        (MarkupString)Markdown.ToHtml(content, MarkdownPipeline);

    private string? _projectId;
    private string? _projectName;
    private bool _accessDenied;
    private string? _userId;
    private List<AgentDefinition> _accessibleAgents = new();
    private AgentDefinition? _selectedAgent;
    private bool _agentLocked;
    private bool _noAgentsAccessible;
    private ConversationSession? _conversation;
    private List<ConversationSession> _conversations = new();
    private IReadOnlyList<AgentTaskInfo> _agentTasks = Array.Empty<AgentTaskInfo>();
    private string? _taskFilterConversationId;
    private string? _taskStatusFilter;
    private string _conversationSearch = string.Empty;
    private string _inputText = string.Empty;
    private bool _isStreaming;
    private bool _disposed;
    private System.Threading.Timer? _pollingTimer;
    private CancellationTokenSource _streamingCts = new();
    private ElementReference _scrollAnchor;
    private IJSObjectReference? _jsModule;
    private FluentTextArea? _inputTextArea;
    private DotNetObjectReference<Chat>? _dotNetRef;

    private IReadOnlyList<ConversationSession> FilteredConversations => string.IsNullOrWhiteSpace(_conversationSearch)
        ? _conversations
        : _conversations
            .Where(c => GetConversationTitle(c).Contains(_conversationSearch, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private IReadOnlyList<AgentTaskInfo> FilteredTasks => _taskFilterConversationId == null
        ? _agentTasks
        : _agentTasks.Where(t => t.ConversationId == _taskFilterConversationId).ToList();

    private IReadOnlyList<AgentTaskInfo> DisplayedTasks => _taskStatusFilter switch
    {
        "Active" => FilteredTasks.Where(t => t.Status is AgentTaskStatus.Running or AgentTaskStatus.Pending).ToList(),
        "Completed" => FilteredTasks.Where(t => t.Status == AgentTaskStatus.Completed).ToList(),
        "Failed" => FilteredTasks.Where(t => t.Status == AgentTaskStatus.Failed).ToList(),
        _ => FilteredTasks
    };

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/signin");
            return;
        }

        var selected = await SelectedProjectService.GetSelectedProjectAsync(UserSession.UserId ?? string.Empty);
        if (selected == null)
        {
            NavigationManager.NavigateTo("/projects");
            return;
        }

        _projectId = selected.ProjectId;
        _projectName = selected.ProjectName;

        var accessToken = UserSession.AccessToken ?? string.Empty;
        var accountAdminUserId = UserSession.UserId ?? string.Empty;

        var isBimManager = await RoleService.IsBimManagerAsync(_projectId, accountAdminUserId, accessToken);
        if (!isBimManager)
        {
            _accessDenied = true;
            return;
        }

        // Give the agent's tools the project this page is scoped to, so the LLM never has to
        // supply (or guess) a project ID itself.
        ChatService.SetProjectContext(_projectId);
        ChatService.SetHubContext(selected.HubId);

        var userRoles = await RoleService.GetProjectRolesAsync(_projectId, accountAdminUserId, accessToken);

        _userId = UserSession.UserEmail ?? UserSession.UserName ?? "unknown";

        var allAgents = await AgentRegistryService.GetAgentsByProjectAsync(_projectId);
        _accessibleAgents = allAgents
            .Where(a => userRoles.Any(r => string.Equals(r, a.RoleName, StringComparison.OrdinalIgnoreCase)))
            .ToList();

        if (_accessibleAgents.Count == 0)
        {
            _noAgentsAccessible = true;
            return;
        }

        if (_accessibleAgents.Count == 1)
        {
            _selectedAgent = _accessibleAgents[0];
            await StartConversationForSelectedAgentAsync();
            return;
        }

        // Multiple accessible agents: if the user already has a conversation with one of them,
        // resume the most recent conversation and lock to that agent so the selector never shows.
        var existing = new List<ConversationSession>();
        foreach (var agent in _accessibleAgents)
        {
            existing.AddRange(await ConversationService.GetConversationsAsync(_projectId, _userId, agent.AgentId));
        }

        var mostRecent = existing.OrderByDescending(c => c.LastActivityAt).FirstOrDefault();
        if (mostRecent != null)
        {
            _selectedAgent = _accessibleAgents.FirstOrDefault(a => a.AgentId == mostRecent.AgentId);
            if (_selectedAgent != null)
            {
                await StartConversationForSelectedAgentAsync();
                return;
            }
        }

        // Otherwise wait for OnAgentSelectedAsync via the selector UI.
    }

    private async Task StartConversationForSelectedAgentAsync()
    {
        if (_projectId == null || _userId == null || _selectedAgent == null) return;

        await ChatService.SetAgentContextAsync(_selectedAgent.AgentId);

        _conversations = (await ConversationService.GetConversationsAsync(_projectId, _userId, _selectedAgent.AgentId)).ToList();
        if (_conversations.Count == 0)
        {
            _conversations.Add(await ConversationService.CreateConversationAsync(_projectId, _userId, _selectedAgent.AgentId));
        }

        _conversation = _conversations[0];
        ChatService.SetConversationContext(_conversation.ConversationId);
        _taskFilterConversationId = _conversation.ConversationId;
        _agentLocked = true;

        _agentTasks = await TaskService.GetTasksByProjectAsync(_projectId);

        _pollingTimer ??= new System.Threading.Timer(async _ =>
        {
            if (_disposed || _projectId == null) return;
            try
            {
                _agentTasks = await TaskService.GetTasksByProjectAsync(_projectId);
                _conversations = _conversations.OrderByDescending(c => c.LastActivityAt).ToList();
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException) { }
            catch (Exception ex)
            {
                Console.WriteLine($"Task poll error: {ex.Message}");
            }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task OnAgentSelectedAsync()
    {
        if (_selectedAgent == null) return;
        await StartConversationForSelectedAgentAsync();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import",
                "./Components/Pages/Chat.razor.js");

            if (_inputTextArea != null)
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await _jsModule.InvokeVoidAsync("setupEnterToSend", _inputTextArea.Element, _dotNetRef);
            }

            if (_conversation != null && _conversation.Messages.Count > 0)
            {
                await ScrollToBottomAsync();
            }
        }
    }

    [JSInvokable]
    public async Task SendMessageFromJs()
    {
        await SendMessage();
    }

    private async Task SendMessage()
    {
        if (_conversation == null || _isStreaming || string.IsNullOrWhiteSpace(_inputText))
            return;

        var text = _inputText.Trim();
        _inputText = string.Empty;

        var userMessage = new ConversationMessage
        {
            Role = "user",
            Content = text,
            Timestamp = DateTime.UtcNow
        };
        _conversation.Messages.Add(userMessage);
        await ConversationService.AddMessageAsync(_conversation.ConversationId, userMessage);

        var assistantMessage = new ConversationMessage
        {
            Role = "assistant",
            Content = string.Empty,
            Timestamp = DateTime.UtcNow
        };
        _conversation.Messages.Add(assistantMessage);

        _isStreaming = true;
        await InvokeAsync(StateHasChanged);
        await ScrollToBottomAsync();

        _streamingCts.Dispose();
        _streamingCts = new CancellationTokenSource();

        try
        {
            await foreach (var token in ChatService.StreamResponseAsync(text, _streamingCts.Token))
            {
                assistantMessage.Content += token;
                await InvokeAsync(StateHasChanged);
                await ScrollToBottomAsync();
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            assistantMessage.Content = $"[Error: {ex.Message}]";
        }
        finally
        {
            assistantMessage.Timestamp = DateTime.UtcNow;
            await ConversationService.AddMessageAsync(_conversation.ConversationId, assistantMessage);
            _conversations = _conversations.OrderByDescending(c => c.LastActivityAt).ToList();
            _isStreaming = false;
            await InvokeAsync(StateHasChanged);
            await ScrollToBottomAsync();
        }
    }

    private async Task StartNewConversationAsync()
    {
        if (_projectId == null || _userId == null || _selectedAgent == null) return;

        var created = await ConversationService.CreateConversationAsync(_projectId, _userId, _selectedAgent.AgentId);
        _conversations.Insert(0, created);
        await SelectConversationAsync(created);
    }

    private async Task SelectConversationAsync(ConversationSession convo)
    {
        _conversation = convo;
        _taskFilterConversationId = convo.ConversationId;
        ChatService.SetConversationContext(convo.ConversationId);
        await InvokeAsync(StateHasChanged);
        await ScrollToBottomAsync();
    }

    private async Task ClearChatAsync()
    {
        if (_conversation == null) return;

        await ConversationService.ClearMessagesAsync(_conversation.ConversationId);
        await ChatService.ResetSessionAsync(_conversation.ConversationId);
        _conversation.Messages.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private void SetQuickPrompt(string text)
    {
        _inputText = text;
    }

    private void ClearTaskFilter()
    {
        _taskFilterConversationId = null;
    }

    private async Task SelectTaskAsync(AgentTaskInfo task)
    {
        var convo = _conversations.FirstOrDefault(c => c.ConversationId == task.ConversationId);
        if (convo != null && convo != _conversation)
        {
            _conversation = convo;
            ChatService.SetConversationContext(convo.ConversationId);
        }

        await InvokeAsync(StateHasChanged);

        if (!string.IsNullOrEmpty(task.RelatedMessageId))
        {
            await ScrollToMessageAsync(task.RelatedMessageId);
        }
        else
        {
            await ScrollToBottomAsync();
        }
    }

    private static string GetConversationTitle(ConversationSession convo)
    {
        var firstUserMessage = convo.Messages
            .FirstOrDefault(m => string.Equals(m.Role, "user", StringComparison.OrdinalIgnoreCase));

        if (firstUserMessage == null || string.IsNullOrWhiteSpace(firstUserMessage.Content))
        {
            return "New conversation";
        }

        var text = firstUserMessage.Content.Trim();
        return text.Length > 40 ? text[..40] + "…" : text;
    }

    private int TaskCount(string conversationId) =>
        _agentTasks.Count(t => t.ConversationId == conversationId);

    private bool HasActiveTask(string conversationId) =>
        _agentTasks.Any(t => t.ConversationId == conversationId && t.Status is AgentTaskStatus.Running or AgentTaskStatus.Pending);

    private static List<(string Label, List<ConversationSession> Items)> GroupConversationsByDate(IReadOnlyList<ConversationSession> conversations)
    {
        var today = DateTime.Now.Date;
        var groups = new List<(string Label, List<ConversationSession> Items)>
        {
            ("Today", new List<ConversationSession>()),
            ("Yesterday", new List<ConversationSession>()),
            ("Earlier", new List<ConversationSession>())
        };

        foreach (var convo in conversations)
        {
            var localDate = convo.LastActivityAt.ToLocalTime().Date;
            var index = localDate == today ? 0 : localDate == today.AddDays(-1) ? 1 : 2;
            groups[index].Items.Add(convo);
        }

        return groups.Where(g => g.Items.Count > 0).ToList();
    }

    private static List<(string Label, List<AgentTaskInfo> Items)> GroupTasksByStatus(IReadOnlyList<AgentTaskInfo> tasks)
    {
        var groups = new List<(string Label, List<AgentTaskInfo> Items)>
        {
            ("Active", tasks.Where(t => t.Status is AgentTaskStatus.Running or AgentTaskStatus.Pending).ToList()),
            ("Completed", tasks.Where(t => t.Status == AgentTaskStatus.Completed).ToList()),
            ("Failed", tasks.Where(t => t.Status is AgentTaskStatus.Failed or AgentTaskStatus.Cancelled).ToList())
        };

        return groups.Where(g => g.Items.Count > 0).ToList();
    }

    private static string FormatDuration(DateTime start, DateTime end)
    {
        var elapsed = end - start;
        if (elapsed.TotalMinutes < 1) return $"{Math.Max(1, (int)elapsed.TotalSeconds)} sec";
        if (elapsed.TotalHours < 1) return $"{(int)elapsed.TotalMinutes} min";
        return $"{(int)elapsed.TotalHours} hr {(int)elapsed.Minutes} min";
    }

    private async Task ScrollToBottomAsync()
    {
        if (_jsModule == null) return;
        try
        {
            await _jsModule.InvokeVoidAsync("scrollIntoView", _scrollAnchor);
        }
        catch (JSDisconnectedException) { }
        catch (Exception) { }
    }

    private async Task ScrollToMessageAsync(string messageId)
    {
        if (_jsModule == null) return;
        try
        {
            await _jsModule.InvokeVoidAsync("scrollToElementById", $"msg-{messageId}");
        }
        catch (JSDisconnectedException) { }
        catch (Exception) { }
    }

    private static string GetTaskItemClass(AgentTaskStatus status) => status switch
    {
        AgentTaskStatus.Completed => "task-item-completed",
        AgentTaskStatus.Failed or AgentTaskStatus.Cancelled => "task-item-failed",
        _ => "task-item-active"
    };

    private static string GetTaskBadgeStyle(AgentTaskStatus status) => status switch
    {
        AgentTaskStatus.Completed => "background-color: #107c10;",
        AgentTaskStatus.Running => "background-color: #ca5010;",
        AgentTaskStatus.Pending => "background-color: #ca5010;",
        AgentTaskStatus.Failed => "background-color: #d13438;",
        _ => "background-color: #797775;"
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _pollingTimer?.Dispose();
        try
        {
            _streamingCts.Cancel();
        }
        catch (ObjectDisposedException) { }
        _streamingCts.Dispose();

        if (_jsModule != null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }

        _dotNetRef?.Dispose();
    }
}
