@page "/settings/assistants"
@using ApsSamples.Models
@using ApsSamples.Services
@using Microsoft.FluentUI.AspNetCore.Components
@inject IUserSessionService UserSession
@inject IProjectRoleService RoleService
@inject IAgentRegistryService AgentRegistryService
@inject ISsaService SsaService
@inject ISsaAppStore SsaAppStore
@inject IAPSAuthenticationService AuthService
@inject IToolCatalogService ToolCatalogService
@inject ICompanyService CompanyService
@inject ISelectedProjectService SelectedProjectService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Assistants - @(_projectName ?? "Project")</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
    <div>
        <a href="/settings" style="font-size: 13px;">&larr; Settings</a>
        <h1>Assistants</h1>
        @if (!string.IsNullOrEmpty(_projectName))
        {
            <p style="color: var(--neutral-foreground-hint); margin: 5px 0 0 0;">
                Project: @_projectName
            </p>
        }
    </div>

    @if (_accessDenied)
    {
        <FluentMessageBar Intent="MessageIntent.Warning">
            Access denied. You do not have the Project Admin role for this project.
        </FluentMessageBar>
    }
    else if (_isLoading)
    {
        <FluentStack HorizontalAlignment="HorizontalAlignment.Center">
            <FluentProgressRing />
            <span>Loading assistants...</span>
        </FluentStack>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <FluentMessageBar Intent="MessageIntent.Error">@_errorMessage</FluentMessageBar>
        }

        @if (!string.IsNullOrEmpty(_infoMessage))
        {
            <FluentMessageBar Intent="MessageIntent.Success">@_infoMessage</FluentMessageBar>
        }

        <FluentCard Style="padding: 24px;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                <h3 style="margin: 0;">APS apps for assistants</h3>
                <p style="color: var(--neutral-foreground-hint); margin: 0;">
                    Each assistant is a secure service account (SSA) owned by one of these apps. Each app must be a
                    server-to-server app and holds at most @MaxSsasPerApp SSAs, so add more apps to create more assistants.
                </p>

                @if (_apps.Any())
                {
                    <FluentDataGrid Items="@_apps.AsQueryable()"
                                    ResizableColumns="true"
                                    RowSize="DataGridRowSize.Medium"
                                    Style="width: 100%;">
                        <PropertyColumn Property="@(a => a.DisplayName)" Sortable="true" Title="Name" />
                        <PropertyColumn Property="@(a => a.MaskedClientId)" Title="Client ID" />
                        <TemplateColumn Title="SSAs">
                            @(SsaCountText(context))
                        </TemplateColumn>
                        <PropertyColumn Property="@(a => a.CreatedAt)" Sortable="true" Title="Created At" Format="yyyy-MM-dd HH:mm" />
                        <TemplateColumn Title="Actions">
                            <FluentButton Appearance="Appearance.Lightweight"
                                          IconStart="@(new Icons.Regular.Size16.Key())"
                                          OnClick="@(() => OpenUpdateSecret(context))"
                                          Title="Update the client secret">
                                Update secret
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Lightweight"
                                          IconStart="@(new Icons.Regular.Size16.Delete())"
                                          OnClick="@(() => OpenRemoveApp(context))"
                                          Title="Remove the app and its assistants">
                                Remove
                            </FluentButton>
                        </TemplateColumn>
                    </FluentDataGrid>
                }
                else
                {
                    <FluentMessageBar Intent="MessageIntent.Warning">
                        No APS app is configured for this project. Add an APS app before creating assistants.
                    </FluentMessageBar>
                }

                <div>
                    <FluentButton Appearance="Appearance.Outline"
                                  IconStart="@(new Icons.Regular.Size20.Add())"
                                  OnClick="OpenAddApp">
                        Add APS app
                    </FluentButton>
                </div>
            </FluentStack>
        </FluentCard>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
            <FluentButton Appearance="Appearance.Accent"
                          IconStart="@(new Icons.Regular.Size20.Add())"
                          OnClick="OpenCreateWizard"
                          Disabled="@(!CanCreateAssistant)"
                          Title="@CreateAssistantTitle">
                Create New Assistant
            </FluentButton>
            <span style="color: var(--neutral-foreground-hint); font-size: 13px;">
                @_agents.Count assistants configured &middot; @FreeSsaSlots free SSA slots across @_apps.Count APS app(s)
            </span>
            <FluentButton Appearance="Appearance.Outline"
                          IconStart="@(new Icons.Regular.Size20.Delete())"
                          Disabled="@_deletingAllSsas"
                          OnClick="DeleteAllSsaAccounts"
                          Title="TEMPORARY: deletes every SSA account on this project's apps. SSAs tracked by an assistant in this project are removed from the project first and their assistant is deleted.">
                @(_deletingAllSsas ? "Deleting all SSAs..." : "DEV: Delete All SSA Accounts")
            </FluentButton>
        </FluentStack>

        @if (_agents.Any())
        {
            <FluentDataGrid Items="@_agents.AsQueryable()"
                            ResizableColumns="true"
                            RowSize="DataGridRowSize.Medium"
                            Style="width: 100%;">
                <PropertyColumn Property="@(a => a.AgentName)" Sortable="true" Title="Assistant Name" />
                <PropertyColumn Property="@(a => a.RoleName)" Sortable="true" Title="Role" />
                <PropertyColumn Property="@(a => a.CreatedAt)" Sortable="true" Title="Created At" Format="yyyy-MM-dd HH:mm" />
                <TemplateColumn Title="Actions">
                    <FluentButton Appearance="Appearance.Lightweight"
                                  IconStart="@(new Icons.Regular.Size16.Delete())"
                                  Disabled="@(_deletingAgentId == context.AgentId)"
                                  OnClick="@(() => DeleteAgent(context))"
                                  Title="Delete assistant">
                        @(_deletingAgentId == context.AgentId ? "Deleting..." : "Delete")
                    </FluentButton>
                </TemplateColumn>
            </FluentDataGrid>
        }
        else
        {
            <FluentMessageBar Intent="MessageIntent.Info">
                No assistants configured yet. Click "Create New Assistant" to add one.
            </FluentMessageBar>
        }
    }
</FluentStack>

<FluentDialog @bind-Hidden="@_hideWizard"
              Modal="true"
              TrapFocus="true"
              PreventScroll="true"
              Style="min-width: 720px; max-width: 90vw;">
    <FluentDialogHeader>
        <FluentLabel Typo="Typography.PaneHeader">Create New Assistant</FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        @if (_wizardBusy)
        {
            <FluentStack HorizontalAlignment="HorizontalAlignment.Center" Style="padding: 30px;">
                <FluentProgressRing />
                <span>Creating assistant (this may take up to a minute)...</span>
            </FluentStack>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_wizardError))
            {
                <FluentMessageBar Intent="MessageIntent.Error">@_wizardError</FluentMessageBar>
            }

            @if (_wizardStep == 1)
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                    <h3 style="margin: 0;">Step 1 of 3 &mdash; Assistant Details</h3>

                    <FluentSelect TOption="ProjectRoleInfo"
                                  Items="@_availableRoles"
                                  OptionValue="@(r => r.RoleId)"
                                  OptionText="@(r => r.RoleName)"
                                  Value="@_selectedRoleId"
                                  ValueChanged="@OnRoleChanged"
                                  Label="Project Role"
                                  Placeholder="Select role..."
                                  Style="width: 100%;" />

                    @if (!string.IsNullOrEmpty(_selectedRoleName))
                    {
                        <div>
                            <strong>Assistant Name:</strong>
                            <span style="color: var(--neutral-foreground-hint); margin-left: 8px;">
                                @($"{_selectedRoleName} Assistant")
                            </span>
                        </div>
                    }

                    <FluentSelect TOption="CompanyInfo"
                                  Items="@_companies"
                                  OptionValue="@(c => c.CompanyId)"
                                  OptionText="@(c => c.CompanyName)"
                                  @bind-Value="_selectedCompanyId"
                                  Label="Company (optional)"
                                  Placeholder="Select company (optional)..."
                                  Style="width: 100%;" />

                    <FluentTextArea @bind-Value="_instructionsText"
                                    Label="Instructions"
                                    Placeholder="@_instructionsPlaceholder"
                                    Rows="8"
                                    Style="width: 100%;" />
                </FluentStack>
            }
            else if (_wizardStep == 2)
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                    <h3 style="margin: 0;">Step 2 of 3 &mdash; Forma Products</h3>
                    <p style="color: var(--neutral-foreground-hint); margin: 0;">
                        Data Management is always granted. Optionally, grant the assistant access to the other Forma products in this project.
                    </p>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                        <FluentCheckbox Label="Data Management"
                                        Value="true"
                                        Disabled="true"
                                        title="Granted by default; sent to APS automatically when no other product is selected." />
                        @foreach (var product in FormaProducts)
                        {
                            <FluentCheckbox Label="@product.Label"
                                            Value="@_selectedProductKeys.Contains(product.Key)"
                                            ValueChanged="@((bool v) => ToggleProduct(product.Key, v))" />
                        }
                    </FluentStack>
                </FluentStack>
            }
            else if (_wizardStep == 3)
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                    <h3 style="margin: 0;">Step 3 of 3 &mdash; Tools</h3>
                    <FluentCard Style="height: 420px; padding: 16px; display: flex; flex-direction: column;">
                        <p style="color: var(--neutral-foreground-hint); margin: 0 0 12px 0;">
                            Select at least one tool. The assistant will invoke these to perform tasks.
                        </p>
                        <FluentTextField @bind-Value="_toolSearchText"
                                          Placeholder="Search tools..."
                                          Style="width: 100%; margin-bottom: 12px; flex-shrink: 0;" />
                        <div style="flex: 1; overflow-y: auto;">
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                                @foreach (var group in FilteredToolGroups)
                                {
                                    <h4 style="margin: 4px 0 0 0;">@group.Key</h4>
                                    @foreach (var tool in group)
                                    {
                                        <div style="border-bottom: 1px solid var(--neutral-stroke-divider-rest); padding-bottom: 8px;">
                                            <FluentCheckbox Label="@tool.DisplayName"
                                                            Value="@_selectedToolIds.Contains(tool.ToolId)"
                                                            ValueChanged="@((bool v) => ToggleTool(tool.ToolId, v))" />
                                            <span style="cursor: pointer; color: var(--accent-fill-rest); font-size: 12px; margin-left: 24px; text-decoration: underline;"
                                                  @onclick="@(() => ToggleDetails(tool.ToolId))">
                                                @(_expandedToolIds.Contains(tool.ToolId) ? "hide details" : "details")
                                            </span>
                                            @if (_expandedToolIds.Contains(tool.ToolId))
                                            {
                                                <div style="font-size: 12px; color: var(--neutral-foreground-hint); margin-left: 24px; margin-top: 4px;">
                                                    @tool.Description
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                @if (!FilteredTools.Any())
                                {
                                    <span style="color: var(--neutral-foreground-hint); font-size: 13px;">No tools match your search.</span>
                                }
                            </FluentStack>
                        </div>
                    </FluentCard>
                </FluentStack>
            }
        }
    </FluentDialogBody>
    <FluentDialogFooter>
        @if (!_wizardBusy)
        {
            <FluentButton Appearance="Appearance.Neutral" OnClick="CancelWizard">Cancel</FluentButton>
            @if (_wizardStep > 1)
            {
                <FluentButton Appearance="Appearance.Neutral"
                              IconStart="@(new Icons.Regular.Size16.ArrowLeft())"
                              OnClick="PreviousStep">
                    Back
                </FluentButton>
            }
            @if (_wizardStep < 3)
            {
                <FluentButton Appearance="Appearance.Accent"
                              IconEnd="@(new Icons.Regular.Size16.ArrowRight())"
                              Disabled="@(!CanAdvance())"
                              OnClick="NextStep">
                    Next
                </FluentButton>
            }
            else
            {
                <FluentButton Appearance="Appearance.Accent"
                              IconStart="@(new Icons.Regular.Size16.Checkmark())"
                              Disabled="@(!CanFinish())"
                              OnClick="FinishWizard">
                    Finish
                </FluentButton>
            }
        }
    </FluentDialogFooter>
</FluentDialog>

<FluentDialog @bind-Hidden="@HideAddApp"
              Modal="true"
              TrapFocus="true"
              PreventScroll="true"
              Style="min-width: 520px; max-width: 90vw;">
    <FluentDialogHeader>
        <FluentLabel Typo="Typography.PaneHeader">Add APS app</FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
            @if (!string.IsNullOrEmpty(_appDialogError))
            {
                <FluentMessageBar Intent="MessageIntent.Error">@_appDialogError</FluentMessageBar>
            }
            <p style="color: var(--neutral-foreground-hint); margin: 0;">
                Use a server-to-server APS app. The credentials are checked against APS before the app is saved.
            </p>
            <FluentTextField @bind-Value="_newAppDisplayName"
                             Label="Display name (optional)"
                             Disabled="@_appDialogBusy"
                             Style="width: 100%;" />
            <FluentTextField @bind-Value="_newAppClientId"
                             Label="Client ID"
                             Disabled="@_appDialogBusy"
                             Style="width: 100%;" />
            <FluentTextField @bind-Value="_newAppSecret"
                             TextFieldType="TextFieldType.Password"
                             Label="Client secret"
                             Disabled="@_appDialogBusy"
                             Style="width: 100%;" />
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Neutral"
                      Disabled="@_appDialogBusy"
                      OnClick="@(() => HideAddApp = true)">
            Cancel
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent"
                      Loading="@_appDialogBusy"
                      Disabled="@(_appDialogBusy || string.IsNullOrWhiteSpace(_newAppClientId) || string.IsNullOrWhiteSpace(_newAppSecret))"
                      OnClick="SaveNewApp">
            Save
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<FluentDialog @bind-Hidden="@HideUpdateSecret"
              Modal="true"
              TrapFocus="true"
              PreventScroll="true"
              Style="min-width: 520px; max-width: 90vw;">
    <FluentDialogHeader>
        <FluentLabel Typo="Typography.PaneHeader">Update secret</FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
            @if (!string.IsNullOrEmpty(_appDialogError))
            {
                <FluentMessageBar Intent="MessageIntent.Error">@_appDialogError</FluentMessageBar>
            }
            <FluentTextField Value="@(_appToUpdate?.MaskedClientId)"
                             Label="Client ID"
                             ReadOnly="true"
                             Style="width: 100%;" />
            <FluentTextField @bind-Value="_updatedSecret"
                             TextFieldType="TextFieldType.Password"
                             Label="New client secret"
                             Disabled="@_appDialogBusy"
                             Style="width: 100%;" />
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Neutral"
                      Disabled="@_appDialogBusy"
                      OnClick="@(() => HideUpdateSecret = true)">
            Cancel
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent"
                      Loading="@_appDialogBusy"
                      Disabled="@(_appDialogBusy || string.IsNullOrWhiteSpace(_updatedSecret))"
                      OnClick="SaveUpdatedSecret">
            Save
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<FluentDialog @bind-Hidden="@_hideRemoveApp"
              Modal="true"
              TrapFocus="true"
              PreventScroll="true"
              Style="min-width: 520px; max-width: 90vw;">
    <FluentDialogHeader>
        <FluentLabel Typo="Typography.PaneHeader">Remove APS app</FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
            @if (!string.IsNullOrEmpty(_appDialogError))
            {
                <FluentMessageBar Intent="MessageIntent.Error">@_appDialogError</FluentMessageBar>
            }
            <FluentMessageBar Intent="MessageIntent.Warning">
                Removing this APS app will delete all assistants assigned to it.
            </FluentMessageBar>
            <div>
                <strong>App:</strong>
                <span style="margin-left: 8px;">@AppLabel(_appToRemove)</span>
            </div>
            @if (AgentsOnAppToRemove.Any())
            {
                <div>
                    <strong>Assistants that will be deleted:</strong>
                    <ul style="margin: 4px 0 0 0;">
                        @foreach (var agent in AgentsOnAppToRemove)
                        {
                            <li>@agent.AgentName</li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <span style="color: var(--neutral-foreground-hint);">No assistants in this project are assigned to this app.</span>
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Neutral"
                      Disabled="@_appDialogBusy"
                      OnClick="@(() => _hideRemoveApp = true)">
            Cancel
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent"
                      IconStart="@(new Icons.Regular.Size16.Delete())"
                      Loading="@_appDialogBusy"
                      Disabled="@_appDialogBusy"
                      OnClick="ConfirmRemoveApp">
            Delete
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    private const int MaxSsasPerApp = ApsSamples.Services.SsaService.MaxSsasPerApp;

    // Keys must match the ACC/Forma "productKeys" enum from the admin-projects-project-Id-users-POST
    // endpoint (https://aps.autodesk.com/en/docs/acc/v1/reference/http/admin-projects-project-Id-users-POST/).
    // "docs" (Data Management) is always granted, so it's rendered as a separate disabled/checked checkbox
    // instead of an entry in this list. SsaService adds "docs" when no optional product is selected.
    private static readonly (string Key, string Label)[] FormaProducts = new[]
    {
        ("designCollaboration", "Design Collaboration"),
        ("modelCoordination", "Model Coordination"),
        ("autoSpecs", "AutoSpecs"),
        ("build", "Build"),
        ("cost", "Cost Management"),
        ("insight", "Insight"),
        ("projectAdministration", "Project Administration"),
        ("takeoff", "Takeoff")
    };

    private bool _isLoading = true;
    private bool _deletingAllSsas;
    private bool _accessDenied;
    private string? _errorMessage;
    private string? _infoMessage;
    private string? _projectName;
    private string? _projectId;
    private string? _deletingAgentId;

    private List<AgentDefinition> _agents = new();
    private List<ProjectRoleInfo> _allRoles = new();
    private List<ProjectRoleInfo> _availableRoles = new();
    private List<ToolDescriptor> _allTools = new();
    private List<CompanyInfo> _companies = new();

    // The project's APS apps and each app's live SSA count (null when the count failed).
    private List<SsaAppCredential> _apps = new();
    private Dictionary<string, int?> _ssaCounts = new(StringComparer.OrdinalIgnoreCase);

    // Shared by the add, update-secret and remove app dialogs; only one is open at a time.
    private bool _appDialogBusy;
    private string? _appDialogError;

    // Secrets live only in these fields while a dialog is open; closing a dialog clears them.
    private bool _hideAddApp = true;
    private string _newAppDisplayName = string.Empty;
    private string _newAppClientId = string.Empty;
    private string _newAppSecret = string.Empty;

    private bool _hideUpdateSecret = true;
    private SsaAppCredential? _appToUpdate;
    private string _updatedSecret = string.Empty;

    private bool _hideRemoveApp = true;
    private SsaAppCredential? _appToRemove;

    private bool HideAddApp
    {
        get => _hideAddApp;
        set
        {
            _hideAddApp = value;
            if (value) _newAppSecret = string.Empty;
        }
    }

    private bool HideUpdateSecret
    {
        get => _hideUpdateSecret;
        set
        {
            _hideUpdateSecret = value;
            if (value) _updatedSecret = string.Empty;
        }
    }

    // Apps whose count is unknown are treated as having room; CreateSsaAsync re-counts anyway.
    private bool CanCreateAssistant =>
        _apps.Any(a => _ssaCounts.GetValueOrDefault(a.ClientId) is not int used || used < MaxSsasPerApp);

    private string CreateAssistantTitle =>
        !_apps.Any() ? "Add an APS app before creating assistants"
        : !CanCreateAssistant ? $"Every APS app has {MaxSsasPerApp} SSAs. Add another APS app to create more assistants."
        : "Create a new assistant";

    private int FreeSsaSlots =>
        _ssaCounts.Values.OfType<int>().Sum(used => Math.Max(0, MaxSsasPerApp - used));

    private IEnumerable<AgentDefinition> AgentsOnAppToRemove =>
        _appToRemove is null
            ? Enumerable.Empty<AgentDefinition>()
            : _agents.Where(a => string.Equals(a.SsaClientId, _appToRemove.ClientId, StringComparison.OrdinalIgnoreCase));

    private bool _hideWizard = true;
    private int _wizardStep = 1;
    private bool _wizardBusy;
    private string? _wizardError;

    private string _selectedRoleId = string.Empty;
    private string _selectedRoleName = string.Empty;
    private string _instructionsText = string.Empty;
    private string _instructionsPlaceholder = "You are an assistant scoped to this project...";
    private HashSet<string> _selectedToolIds = new();
    private string _selectedCompanyId = string.Empty;
    private HashSet<string> _selectedProductKeys = new();
    private string _toolSearchText = string.Empty;
    private HashSet<string> _expandedToolIds = new();

    private IEnumerable<ToolDescriptor> FilteredTools =>
        string.IsNullOrWhiteSpace(_toolSearchText)
            ? _allTools
            : _allTools.Where(t =>
                t.DisplayName.Contains(_toolSearchText, StringComparison.OrdinalIgnoreCase)
                || t.Description.Contains(_toolSearchText, StringComparison.OrdinalIgnoreCase));

    // GroupBy keeps groups in order of first appearance, so modules follow the catalog order.
    private IEnumerable<IGrouping<string, ToolDescriptor>> FilteredToolGroups =>
        FilteredTools.GroupBy(t => string.IsNullOrWhiteSpace(t.Module) ? "Other" : t.Module);

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/signin");
            return;
        }

        var selected = await SelectedProjectService.GetSelectedProjectAsync(UserSession.UserId ?? string.Empty);
        if (selected == null)
        {
            NavigationManager.NavigateTo("/projects");
            return;
        }

        _projectId = selected.ProjectId;
        _projectName = selected.ProjectName;

        var accessToken = UserSession.AccessToken ?? string.Empty;
        var userId = UserSession.UserId ?? string.Empty;

        var isAdmin = await RoleService.IsProjectAdminAsync(_projectId, userId, accessToken);
        if (!isAdmin)
        {
            _accessDenied = true;
            _isLoading = false;
            return;
        }

        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;
            StateHasChanged();

            var accessToken = UserSession.AccessToken ?? string.Empty;

            _agents = (await AgentRegistryService.GetAgentsByProjectAsync(_projectId!)).ToList();
            _allRoles = (await RoleService.GetAllProjectRolesAsync(_projectId!, accessToken)).ToList();
            _allTools = ToolCatalogService.GetAllTools().ToList();
            _companies = (await CompanyService.GetProjectCompaniesAsync(_projectId!, accessToken)).ToList();
            await LoadAppsAsync();

            RefreshAvailableRoles();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading assistants page: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // One GET /service-accounts call per app. Counted one at a time because the per-app
    // management token cache in APSAuthenticationService isn't safe for concurrent use.
    private async Task LoadAppsAsync()
    {
        _apps = SsaAppStore.GetByProject(_projectId!).ToList();
        var counts = new Dictionary<string, int?>(StringComparer.OrdinalIgnoreCase);
        foreach (var app in _apps)
        {
            try
            {
                counts[app.ClientId] = await SsaService.GetSsaCountAsync(app.ClientId);
            }
            catch (Exception ex)
            {
                counts[app.ClientId] = null;
                Console.WriteLine($"Failed to count SSAs for app {app.MaskedClientId}: {ex.Message}");
            }
        }
        _ssaCounts = counts;
    }

    // Reloads agents and apps after any change that can move an SSA count.
    private async Task RefreshAgentsAndAppsAsync()
    {
        _agents = (await AgentRegistryService.GetAgentsByProjectAsync(_projectId!)).ToList();
        RefreshAvailableRoles();
        await LoadAppsAsync();
    }

    private string SsaCountText(SsaAppCredential app) =>
        _ssaCounts.GetValueOrDefault(app.ClientId) is int used
            ? $"{used} / {MaxSsasPerApp} SSAs"
            : "unavailable";

    private static string AppLabel(SsaAppCredential? app) =>
        app is null ? string.Empty
        : string.IsNullOrWhiteSpace(app.DisplayName) ? app.MaskedClientId
        : $"{app.DisplayName} ({app.MaskedClientId})";

    private void OpenAddApp()
    {
        _appDialogError = null;
        _appDialogBusy = false;
        _newAppDisplayName = string.Empty;
        _newAppClientId = string.Empty;
        _newAppSecret = string.Empty;
        HideAddApp = false;
    }

    private async Task SaveNewApp()
    {
        var displayName = _newAppDisplayName.Trim();
        var clientId = _newAppClientId.Trim();
        var secret = _newAppSecret.Trim();
        if (string.IsNullOrEmpty(clientId) || string.IsNullOrEmpty(secret)) return;

        _appDialogBusy = true;
        _appDialogError = null;
        _errorMessage = null;
        _infoMessage = null;
        StateHasChanged();

        try
        {
            if (SsaAppStore.Get(clientId) is not null)
            {
                _appDialogError = "This client ID is already registered for a project.";
                return;
            }

            // Throws InvalidOperationException with the APS error when the credentials are wrong.
            await AuthService.GetSsaAppTwoLeggedTokenAsync(clientId, secret);

            var added = await SsaAppStore.TryAddAsync(new SsaAppCredential
            {
                ProjectId = _projectId!,
                ClientId = clientId,
                ClientSecret = secret,
                DisplayName = displayName,
                CreatedAt = DateTime.UtcNow
            });
            if (!added)
            {
                _appDialogError = "This client ID is already registered for a project.";
                return;
            }

            var label = string.IsNullOrEmpty(displayName) ? "APS app" : $"APS app \"{displayName}\"";
            try
            {
                var adopted = await SsaService.AdoptLegacySsasAsync(_projectId!, clientId);
                _infoMessage = adopted > 0
                    ? $"{label} added. {adopted} existing assistant(s) linked to it."
                    : $"{label} added.";
            }
            catch (Exception ex)
            {
                _infoMessage = $"{label} added, but existing assistants couldn't be linked to it: {ex.Message}";
            }

            HideAddApp = true;
            await RefreshAgentsAndAppsAsync();
        }
        catch (Exception ex)
        {
            _appDialogError = $"Failed to add APS app: {ex.Message}";
        }
        finally
        {
            _appDialogBusy = false;
            StateHasChanged();
        }
    }

    private void OpenUpdateSecret(SsaAppCredential app)
    {
        _appDialogError = null;
        _appDialogBusy = false;
        _appToUpdate = app;
        _updatedSecret = string.Empty;
        HideUpdateSecret = false;
    }

    private async Task SaveUpdatedSecret()
    {
        var secret = _updatedSecret.Trim();
        if (_appToUpdate is null || string.IsNullOrEmpty(secret)) return;

        _appDialogBusy = true;
        _appDialogError = null;
        _errorMessage = null;
        _infoMessage = null;
        StateHasChanged();

        try
        {
            await AuthService.GetSsaAppTwoLeggedTokenAsync(_appToUpdate.ClientId, secret);

            if (!await SsaAppStore.UpdateSecretAsync(_appToUpdate.ClientId, secret))
            {
                _appDialogError = "This APS app is no longer registered.";
                return;
            }

            _infoMessage = $"Secret updated for {AppLabel(_appToUpdate)}.";
            HideUpdateSecret = true;
            await LoadAppsAsync();
        }
        catch (Exception ex)
        {
            _appDialogError = $"Failed to update secret: {ex.Message}";
        }
        finally
        {
            _appDialogBusy = false;
            StateHasChanged();
        }
    }

    private void OpenRemoveApp(SsaAppCredential app)
    {
        _appDialogError = null;
        _appDialogBusy = false;
        _appToRemove = app;
        _hideRemoveApp = false;
    }

    // Deletes every assistant on the app the same way DeleteAgent does, and removes the app only
    // when all of them succeed, so a failed removal can be retried.
    private async Task ConfirmRemoveApp()
    {
        if (_appToRemove is null) return;
        var app = _appToRemove;

        _appDialogBusy = true;
        _appDialogError = null;
        _errorMessage = null;
        _infoMessage = null;
        StateHasChanged();

        var deleted = 0;
        try
        {
            foreach (var agent in AgentsOnAppToRemove.ToList())
            {
                try
                {
                    if (!string.IsNullOrEmpty(agent.SsaId))
                    {
                        await SsaService.DeprovisionSsaAsync(
                            agent.ProjectId,
                            app.ClientId,
                            agent.SsaId,
                            agent.ProjectUserId,
                            UserSession.AccessToken ?? string.Empty);
                    }
                    await AgentRegistryService.DeleteAgentAsync(agent.AgentId);
                    deleted++;
                }
                catch (Exception ex)
                {
                    _appDialogError = $"Failed to delete assistant \"{agent.AgentName}\": {ex.Message}. The APS app was kept, so you can retry.";
                    return;
                }
            }

            await SsaAppStore.RemoveAsync(app.ClientId);
            _hideRemoveApp = true;
            _infoMessage = $"APS app {AppLabel(app)} removed with {deleted} assistant(s).";
        }
        catch (Exception ex)
        {
            _appDialogError = $"Failed to remove APS app: {ex.Message}";
        }
        finally
        {
            await RefreshAgentsAndAppsAsync();
            _appDialogBusy = false;
            StateHasChanged();
        }
    }

    private void RefreshAvailableRoles()
    {
        var usedRoleNames = _agents.Select(a => a.RoleName).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _availableRoles = _allRoles
            .Where(r => !usedRoleNames.Contains(r.RoleName))
            .OrderBy(r => r.RoleName)
            .ToList();
    }

    private void OpenCreateWizard()
    {
        RefreshAvailableRoles();
        _wizardStep = 1;
        _wizardError = null;
        _wizardBusy = false;
        _selectedRoleId = string.Empty;
        _selectedRoleName = string.Empty;
        _instructionsText = string.Empty;
        _instructionsPlaceholder = "You are an assistant scoped to this project...";
        _selectedToolIds.Clear();
        _selectedCompanyId = string.Empty;
        _selectedProductKeys.Clear();
        _toolSearchText = string.Empty;
        _expandedToolIds.Clear();
        _hideWizard = false;
        StateHasChanged();
    }

    private void CancelWizard()
    {
        _hideWizard = true;
        StateHasChanged();
    }

    private void OnRoleChanged(string roleId)
    {
        _selectedRoleId = roleId ?? string.Empty;
        var role = _availableRoles.FirstOrDefault(r => r.RoleId == _selectedRoleId);
        _selectedRoleName = role?.RoleName ?? string.Empty;
        if (!string.IsNullOrEmpty(_selectedRoleName))
        {
            _instructionsPlaceholder = $"You are a {_selectedRoleName} assistant scoped to this project...";
            if (string.IsNullOrWhiteSpace(_instructionsText))
            {
                _instructionsText = _instructionsPlaceholder;
            }
        }
        StateHasChanged();
    }

    private void ToggleTool(string toolId, bool selected)
    {
        if (selected) _selectedToolIds.Add(toolId);
        else _selectedToolIds.Remove(toolId);
    }

    private void ToggleProduct(string key, bool selected)
    {
        if (selected) _selectedProductKeys.Add(key);
        else _selectedProductKeys.Remove(key);
    }

    private void ToggleDetails(string toolId)
    {
        if (!_expandedToolIds.Add(toolId))
        {
            _expandedToolIds.Remove(toolId);
        }
    }

    private bool CanAdvance()
    {
        return _wizardStep switch
        {
            1 => !string.IsNullOrEmpty(_selectedRoleId) && !string.IsNullOrWhiteSpace(_instructionsText),
            _ => true
        };
    }

    private bool CanFinish()
    {
        return !string.IsNullOrEmpty(_selectedRoleId)
               && !string.IsNullOrWhiteSpace(_instructionsText)
               && _selectedToolIds.Count > 0;
    }

    private void NextStep()
    {
        if (CanAdvance() && _wizardStep < 3)
        {
            _wizardStep++;
            _wizardError = null;
        }
    }

    private void PreviousStep()
    {
        if (_wizardStep > 1)
        {
            _wizardStep--;
            _wizardError = null;
        }
    }

    private async Task FinishWizard()
    {
        if (!CanFinish()) return;

        _wizardBusy = true;
        _wizardError = null;
        StateHasChanged();

        try
        {
            var agentName = $"{_selectedRoleName} Assistant";

            var (ssaClientId, ssaId) = await SsaService.CreateSsaAsync(_projectId!, agentName);
            var keyId = await SsaService.StoreSsaKeyAsync(ssaClientId, ssaId);
            var ssaEmail = await SsaService.GetSsaEmailAsync(ssaClientId, ssaId);

            var selectedRole = _allRoles.FirstOrDefault(r =>
                string.Equals(r.RoleName, _selectedRoleName, StringComparison.OrdinalIgnoreCase));
            var roleId = selectedRole?.RoleId ?? _selectedRoleId;

            var projectUserId = await SsaService.AddSsaToProjectAsync(
                _projectId!,
                ssaEmail,
                _selectedCompanyId,
                new List<string> { roleId },
                _selectedProductKeys.ToList(),
                UserSession.AccessToken ?? string.Empty);

            var agent = new AgentDefinition
            {
                AgentId = Guid.NewGuid().ToString(),
                ProjectId = _projectId!,
                RoleName = _selectedRoleName,
                AgentName = agentName,
                InstructionsText = _instructionsText,
                EnabledToolIds = _selectedToolIds.ToList(),
                EnabledProductKeys = _selectedProductKeys.ToList(),
                CompanyId = _selectedCompanyId,
                SsaId = ssaId,
                SsaClientId = ssaClientId,
                SsaKeyId = keyId,
                SsaEmail = ssaEmail,
                ProjectUserId = projectUserId,
                CreatedAt = DateTime.UtcNow
            };

            await AgentRegistryService.CreateAgentAsync(agent);

            await RefreshAgentsAndAppsAsync();

            _hideWizard = true;
            _infoMessage = $"Assistant \"{agentName}\" created successfully.";
        }
        catch (Exception ex)
        {
            _wizardError = $"Failed to create assistant: {ex.Message}";
        }
        finally
        {
            _wizardBusy = false;
            StateHasChanged();
        }
    }

    private async Task DeleteAgent(AgentDefinition agent)
    {
        _deletingAgentId = agent.AgentId;
        _errorMessage = null;
        _infoMessage = null;
        StateHasChanged();

        try
        {
            if (!string.IsNullOrEmpty(agent.SsaId))
            {
                // Removes the robot user from the project first, then deletes the SSA.
                await SsaService.DeprovisionSsaAsync(
                    agent.ProjectId,
                    agent.SsaClientId,
                    agent.SsaId,
                    agent.ProjectUserId,
                    UserSession.AccessToken ?? string.Empty);
            }
            await AgentRegistryService.DeleteAgentAsync(agent.AgentId);

            await RefreshAgentsAndAppsAsync();
            _infoMessage = $"Assistant \"{agent.AgentName}\" deleted.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to delete assistant: {ex.Message}";
        }
        finally
        {
            _deletingAgentId = null;
            StateHasChanged();
        }
    }

    // TEMPORARY: dev-only cleanup button to wipe every SSA account on this project's apps. Remove before ship.
    // Every SSA on each app is deleted. Robot users are removed from the project only for SSAs tracked
    // by an agent in this project; untracked SSAs are deleted directly because their project is unknown.
    private async Task DeleteAllSsaAccounts()
    {
        _deletingAllSsas = true;
        _errorMessage = null;
        _infoMessage = null;
        StateHasChanged();

        try
        {
            var deleted = 0;
            var failed = 0;
            var untracked = 0;

            foreach (var app in SsaAppStore.GetByProject(_projectId!))
            {
                var ssaIds = await SsaService.GetAllSsaIdsAsync(app.ClientId);

                foreach (var ssaId in ssaIds)
                {
                    try
                    {
                        var agent = _agents.FirstOrDefault(a => a.SsaId == ssaId);
                        if (agent is null)
                        {
                            await SsaService.DeleteSsaAsync(app.ClientId, ssaId);
                            untracked++;
                        }
                        else
                        {
                            await SsaService.DeprovisionSsaAsync(
                                agent.ProjectId,
                                app.ClientId,
                                agent.SsaId,
                                agent.ProjectUserId,
                                UserSession.AccessToken ?? string.Empty);
                            await AgentRegistryService.DeleteAgentAsync(agent.AgentId);
                        }
                        deleted++;
                    }
                    catch (Exception ex)
                    {
                        failed++;
                        Console.WriteLine($"Failed to delete SSA {ssaId}: {ex.Message}");
                    }
                }
            }

            await RefreshAgentsAndAppsAsync();

            _infoMessage = $"Deleted {deleted} SSA account(s) ({untracked} without project removal), {failed} failed.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to delete all SSA accounts: {ex.Message}";
        }
        finally
        {
            _deletingAllSsas = false;
            StateHasChanged();
        }
    }
}
