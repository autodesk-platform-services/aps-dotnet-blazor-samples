@page "/"
@using ApsSamples.Services
@using Microsoft.FluentUI.AspNetCore.Components
@inject IUserSessionService UserSession
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
    <div>
        <h1>Welcome to Autodesk Platform Services .NET Blazor Samples</h1>
        <p>Explore Autodesk Platform Services with interactive tutorials and samples.</p>
    </div>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="20" Wrap="true">
        <FluentCard Style="max-width: 400px; padding: 24px;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                <FluentIcon Value="@(new Icons.Regular.Size48.DocumentAdd())" Color="Color.Accent" />
                <h3>Create Revit Models</h3>
                <p style="color: var(--neutral-foreground-hint);">
                    Create Revit cloud models in your projects using Automation API.
                </p>
                <FluentButton Appearance="Appearance.Accent"
                             IconStart="@(new Icons.Regular.Size20.DocumentAdd())"
                             OnClick="@(() => NavigationManager.NavigateTo("/create-models"))">
                    Create Models
                </FluentButton>
            </FluentStack>
        </FluentCard>

        <FluentCard Style="max-width: 400px; padding: 24px;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                <FluentIcon Value="@(new Icons.Regular.Size48.TableSimple())" Color="Color.Accent" />
                <h3>Manage Revit Links</h3>
                <p style="color: var(--neutral-foreground-hint);">
                    Add or remove Revit links from your models using Automation API.
                </p>
                <FluentButton Appearance="Appearance.Accent"
                             IconStart="@(new Icons.Regular.Size20.TableSimple())"
                             OnClick="@(() => NavigationManager.NavigateTo("/manage-links"))">
                    Manage Links
                </FluentButton>
            </FluentStack>
        </FluentCard>

        <FluentCard Style="max-width: 400px; padding: 24px;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                <FluentIcon Value="@(new Icons.Regular.Size48.DocumentOnePageMultiple())" Color="Color.Accent" />
                <h3>Create Sheets</h3>
                <p style="color: var(--neutral-foreground-hint);">
                    Create multiple Sheets in Revit models using Automation API.
                </p>
                <FluentButton Appearance="Appearance.Accent"
                             IconStart="@(new Icons.Regular.Size20.DocumentMultiple())"
                             OnClick="@(() => NavigationManager.NavigateTo("/create-sheets"))">
                    Create Sheets
                </FluentButton>
            </FluentStack>
        </FluentCard>

        <FluentCard Style="max-width: 400px; padding: 24px;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                <FluentIcon Value="@(new Icons.Regular.Size48.Cube())" Color="Color.Accent" />
                <h3>Model Viewer</h3>
                <p style="color: var(--neutral-foreground-hint);">
                    View Revit Cloud Models using the APS Viewer and JS Interop.
                </p>
                <FluentButton Appearance="Appearance.Accent"
                              IconStart="@(new Icons.Regular.Size20.Cube())"
                             OnClick="@(() => NavigationManager.NavigateTo("/view-models"))">
                    Model Viewer
                </FluentButton>
            </FluentStack>
        </FluentCard>

        <FluentCard Style="max-width: 400px; padding: 24px;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                <FluentIcon Value="@(new Icons.Regular.Size48.ChatMultiple())" Color="Color.Accent" />
                <h3>Assistants</h3>
                <p style="color: var(--neutral-foreground-hint);">
                    Chat with AI Assistants to automate BIM tasks on your projects.
                </p>
                <FluentButton Appearance="Appearance.Accent"
                             IconStart="@(new Icons.Regular.Size20.ChatMultiple())"
                             OnClick="@(() => NavigationManager.NavigateTo("/chat"))">
                    Assistants
                </FluentButton>
            </FluentStack>
        </FluentCard>

        <FluentCard Style="max-width: 400px; padding: 24px;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                <FluentIcon Value="@(new Icons.Regular.Size48.Bot())" Color="Color.Accent" />
                <h3>Agents</h3>
                <p style="color: var(--neutral-foreground-hint);">
                    Configure and manage AI Agents for your projects.
                </p>
                <FluentButton Appearance="Appearance.Accent"
                             IconStart="@(new Icons.Regular.Size20.Bot())"
                             OnClick="@(() => NavigationManager.NavigateTo("/agents"))">
                    Agents
                </FluentButton>
            </FluentStack>
        </FluentCard>
    </FluentStack>
</FluentStack>

@code {
    protected override void OnInitialized()
    {
        if (!UserSession.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/signin");
            return;
        }
    }
}
