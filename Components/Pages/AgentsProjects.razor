@page "/agents-projects"
@using ApsSamples.Services
@using Autodesk.DataManagement
@using Autodesk.DataManagement.Model
@using Microsoft.FluentUI.AspNetCore.Components
@inject IUserSessionService UserSession
@inject IAPSAuthenticationService ApsAuth
@inject DataManagementClient DataManagementClient
@inject IProjectRoleService RoleService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Agents - Select Project</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
    <div>
        <h1>Agents</h1>
        <p style="color: var(--neutral-foreground-hint); margin: 5px 0 0 0;">
            Select a project to manage its AI agents
        </p>
    </div>

    @if (!UserSession.IsAuthenticated)
    {
        <FluentStack HorizontalAlignment="HorizontalAlignment.Center" Style="margin-top: 60px;">
            <FluentCard Style="max-width: 450px; width: 100%; padding: 30px;">
                <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="20">
                    <FluentIcon Value="@(new Icons.Regular.Size48.LockClosed())" Color="Color.Neutral" Style="align-self: center;" />
                    <h3 style="text-align: center; margin: 0;">Authentication Required</h3>
                    <p style="text-align: center; margin: 0; color: var(--neutral-foreground-hint);">
                        Please login with your Autodesk account to manage agents.
                    </p>
                    <FluentButton IconStart="@(new Icons.Regular.Size20.Person())" OnClick="Login" Appearance="Appearance.Accent">
                        Login with Autodesk
                    </FluentButton>
                </FluentStack>
            </FluentCard>
        </FluentStack>
    }
    else
    {
        @if (_showUnauthorizedBanner)
        {
            <FluentMessageBar Intent="MessageIntent.Warning">
                Access denied. You do not have the Project Admin role for that project.
            </FluentMessageBar>
        }

        @if (_isLoading)
        {
            <FluentStack HorizontalAlignment="HorizontalAlignment.Center">
                <FluentProgressRing />
                <span>Loading projects...</span>
            </FluentStack>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <FluentMessageBar Intent="MessageIntent.Error">
                @_errorMessage
            </FluentMessageBar>
            <FluentButton Appearance="Appearance.Accent" OnClick="LoadAllData">Retry</FluentButton>
        }
        else if (_allProjects != null && _allProjects.Any())
        {
            <FluentDataGrid Items="@_allProjects.AsQueryable()"
                            ResizableColumns="true"
                            RowSize="DataGridRowSize.Medium"
                            Style="width: 100%;">
                <PropertyColumn Property="@(p => p.ProjectName)" Sortable="true" Title="Projects" />
                <PropertyColumn Property="@(p => p.HubName)" Sortable="true" Title="Hub" />
                <PropertyColumn Property="@(p => p.HubRegion)" Title="Region" Width="100px" />
                <TemplateColumn Title="Actions">
                    <FluentButton Appearance="Appearance.Accent"
                                  IconStart="@(new Icons.Regular.Size16.Person())"
                                  OnClick="@(() => NavigationManager.NavigateTo($"/agents/{context.ProjectId}"))">
                        Manage Agents
                    </FluentButton>
                </TemplateColumn>
            </FluentDataGrid>
        }
        else
        {
            <FluentMessageBar Intent="MessageIntent.Info">
                Only projects where you are a Project Admin are shown. No eligible projects were found.
            </FluentMessageBar>
        }
    }
</FluentStack>

@code {
    private bool _isLoading;
    private string? _errorMessage;
    private bool _showUnauthorizedBanner;
    private List<AgentsProjectInfo>? _allProjects;

    private record AgentsProjectInfo(string ProjectId, string HubId, string ProjectName, string HubName, string HubRegion);

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var queryParams = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (queryParams.TryGetValue("error", out var errorValue) &&
            string.Equals(errorValue.ToString(), "unauthorized", StringComparison.OrdinalIgnoreCase))
        {
            _showUnauthorizedBanner = true;
        }

        if (!UserSession.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        await LoadAllData();
    }

    private void Login()
    {
        NavigationManager.NavigateTo("/api/auth/login?returnUrl=/agents-projects", forceLoad: true);
    }

    private async Task LoadAllData()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;
            _allProjects = new List<AgentsProjectInfo>();
            StateHasChanged();

            var accessToken = UserSession.AccessToken ?? string.Empty;
            var userId = UserSession.UserId ?? string.Empty;

            var hubs = await DataManagementClient.GetHubsAsync(accessToken: accessToken);
            var hubsList = hubs.Data?.Where(h => h.Attributes?.Region == Region.US).ToList() ?? new List<HubData>();

            foreach (var hub in hubsList)
            {
                var hubId = hub.Id ?? string.Empty;
                var hubName = hub.Attributes?.Name ?? "Unknown Hub";
                var hubRegion = hub.Attributes?.Region.ToString() ?? "N/A";

                try
                {
                    var projects = await DataManagementClient.GetHubProjectsAsync(
                        accessToken: accessToken,
                        hubId: hubId);

                    var projectsList = projects.Data?.Where(p => p.Attributes?.Extension?.Data["projectType"].ToString() == "ACC").ToList() ?? new List<ProjectData>();

                    foreach (var project in projectsList)
                    {
                        var projectId = project.Id ?? string.Empty;
                        var projectName = project.Attributes?.Name ?? "Unknown Project";

                        if (projectName.Contains("Component Library", StringComparison.OrdinalIgnoreCase))
                        {
                            continue;
                        }

                        var isProjectAdmin = await RoleService.IsProjectAdminAsync(projectId, userId, accessToken);
                        if (!isProjectAdmin)
                        {
                            continue;
                        }

                        _allProjects.Add(new AgentsProjectInfo(
                            projectId,
                            hubId,
                            projectName,
                            hubName,
                            hubRegion));
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading projects from hub {hubName}: {ex.Message}");
                }
            }

            _allProjects = _allProjects.OrderBy(p => p.ProjectName).ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading projects: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}
